# First Weld Master Sway subset. Supplied files replace these settings/bindings.
# Modifiers follow the configured keymap; letter triggers use physical positions.
# Mod1 is logical Alt (physical Windows with these swaps), leaving Super to the
# parent compositor when nested. Use Mod4 below to choose logical Super instead.
input type:keyboard {
    xkb_layout us
    xkb_options ctrl:swapcaps,altwin:swap_lalt_lwin
}
# All Master defaults live here; plugins install no fallback mappings.
gaps inner 8
gaps outer 8
smart_gaps on
smart_borders on
default_orientation horizontal
floating_modifier Mod1
bindsym Mod1+a fullscreen toggle
bindsym Mod1+Shift+a weld fullscreen exclusive
default_border pixel 3
default_floating_border normal 3
corner_radius 9
client.focused   #5994E0 #242B38 #FFFFFF #AACFFF #5994E0
client.unfocused #47576B #242B38 #CCD4DF #778899 #47576B

# Run once per session; exec_always also runs on successful config reload.
# These example paths are relative to Weld's launch directory (the repository root).
exec waybar --config examples/waybar.jsonc --style examples/waybar.css

# Workspace names are global; output assignments override the creation monitor.
# workspace 2 output DP-1 eDP-1
bindsym Mod1+1 workspace number 1
bindsym Mod1+2 workspace number 2
bindsym Mod1+3 workspace number 3
bindsym Mod1+4 workspace number 4
bindsym Mod1+5 workspace number 5
bindsym Mod1+6 workspace number 6
bindsym Mod1+7 workspace number 7
bindsym Mod1+8 workspace number 8
bindsym Mod1+9 workspace number 9
bindsym Mod1+0 workspace number 10
bindsym Mod1+Shift+1 move container to workspace number 1
bindsym Mod1+Shift+2 move container to workspace number 2
bindsym Mod1+Shift+3 move container to workspace number 3
bindsym Mod1+Shift+4 move container to workspace number 4
bindsym Mod1+Shift+5 move container to workspace number 5
bindsym Mod1+Shift+6 move container to workspace number 6
bindsym Mod1+Shift+7 move container to workspace number 7
bindsym Mod1+Shift+8 move container to workspace number 8
bindsym Mod1+Shift+9 move container to workspace number 9
bindsym Mod1+Shift+0 move container to workspace number 10

bindsym Mod1+Control+f splith
bindsym Mod1+Control+j splitv
bindsym Mod1+Shift+r reload
bindsym Mod1+Shift+q kill
bindsym Mod1+Shift+space floating toggle
bindsym Mod1+Control+p focus mode_toggle
bindsym Mod1+b border toggle
bindsym Mod1+d focus left
bindsym Mod1+f focus right
bindsym Mod1+k focus up
bindsym Mod1+j focus down
bindsym Mod1+Shift+d move left
bindsym Mod1+Shift+f move right
bindsym Mod1+Shift+k move up
bindsym Mod1+Shift+j move down
bindsym Mod1+Left focus left
bindsym Mod1+Right focus right
bindsym Mod1+Up focus up
bindsym Mod1+Down focus down
bindsym Mod1+Shift+Left move left
bindsym Mod1+Shift+Right move right
bindsym Mod1+Shift+Up move up
bindsym Mod1+Shift+Down move down
bindsym Mod1+Control+Left resize shrink width 5 ppt
bindsym Mod1+Control+Right resize grow width 5 ppt
bindsym Mod1+Control+Up resize shrink height 5 ppt
bindsym Mod1+Control+Down resize grow height 5 ppt

bindsym Mod1+Return exec foot
bindsym Mod1+space exec --no-startup-id rofi -show drun
bindsym Mod1+Shift+Return exec firefox
bindsym Mod1+Shift+b exec blender
bindsym Mod1+h weld hoist
bindsym Mod1+Shift+o weld output-debug
bindsym Mod1+Shift+Escape exit

# Scale actions are registered only for the DRM backend.
bindsym Mod1+equal weld scale increase
bindsym Mod1+minus weld scale decrease

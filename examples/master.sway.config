# First Weld Master Sway subset. Supplied files replace these settings/bindings.
# Modifiers and letter names currently refer to physical key positions.
# All Master defaults live here; plugins install no fallback mappings.
gaps inner 8
gaps outer 8
default_orientation horizontal

bindsym Mod4+F1 splith
bindsym Mod4+F2 splitv
bindsym Mod4+F3 reload
bindsym Mod4+F4 kill
bindsym Mod4+d focus left
bindsym Mod4+f focus right
bindsym Mod4+k focus up
bindsym Mod4+j focus down
bindsym Mod4+Shift+d move left
bindsym Mod4+Shift+f move right
bindsym Mod4+Shift+k move up
bindsym Mod4+Shift+j move down
bindsym Mod4+Left focus left
bindsym Mod4+Right focus right
bindsym Mod4+Up focus up
bindsym Mod4+Down focus down
bindsym Mod4+Shift+Left move left
bindsym Mod4+Shift+Right move right
bindsym Mod4+Shift+Up move up
bindsym Mod4+Shift+Down move down
bindsym Mod4+Control+Left resize shrink width 5 ppt
bindsym Mod4+Control+Right resize grow width 5 ppt
bindsym Mod4+Control+Up resize shrink height 5 ppt
bindsym Mod4+Control+Down resize grow height 5 ppt

bindsym Mod4+Return exec foot
bindsym Mod4+Control+f exec firefox
bindsym Mod4+b exec blender
bindsym Mod4+h weld hoist
bindsym Mod4+Shift+o weld output-debug
bindsym Mod4+Shift+Escape exit

# Scale actions are registered only for the DRM backend.
bindsym Mod4+equal weld scale increase
bindsym Mod4+minus weld scale decrease
bindsym Mod4+Control+F12 weld scale physical

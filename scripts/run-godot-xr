#!/usr/bin/env python3
"""Build, install and launch the Pico XR demo in one command.

Uses the current development shell and shared ADB server. The Godot export hook
builds/stages both Rust targets. No editor settings, app data or pairing are reset.
Tests and linting are separate: scripts/check-godot-xr.
An existing workflow for the same device is stopped and cleaned up first.
"""
import argparse
from dataclasses import dataclass
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import resource
import runpy
import shutil
import signal
import subprocess
import sys
import tempfile
import time

ROOT = Path(__file__).resolve().parent.parent
PROJECT = ROOT / "apps/weld-vr"
MANIFEST = PROJECT / "rust/Cargo.toml"
APK = PROJECT / "build/weld-vr-pico-debug.apk"
PREFLIGHT = runpy.run_path(str(ROOT / "scripts/godot-xr-preflight.py"))
ANDROID_ENV = runpy.run_path(str(ROOT / "scripts/godot-android-env.py"))
ERROR = re.compile(r"(?:SCRIPT ERROR:|SHADER ERROR:|\bERROR:|Rust build failed|This is NOT a successful Rust build)")


@dataclass(frozen=True)
class Step:
    name: str
    command: list[str]
    timeout: int
    marker: str | None = None
    engine: bool = False


def steps():
    godot = [str(ROOT / "scripts/run-godot"), "--path", str(PROJECT)]
    return [
        # Export rechecks native freshness through its normal build hook.
        Step("pico-export", [*godot, "--headless", "--export-debug", "Android Pico", str(APK)], 600, engine=True),
    ]


def validate(step, code, path):
    marker_found = step.marker is None
    preview = False
    build_complete = False
    shutdown_diagnostic = False
    with path.open(errors="replace") as log:
        for line in log:
            preview |= "Godot Engine v4.8.dev6.official.8898c2b3d" in line
            build_complete |= "export" in line and "Build complete." in line
            if step.engine and ERROR.search(line):
                # 4.8-dev6's Android export polling thread reads EditorSettings
                # after editor shutdown. APK generation has already completed.
                # Keep the diagnostic in the log; never accept another error,
                # another engine version, an incomplete export or nonzero exit.
                if (step.name == "pico-export" and code == 0 and preview and build_complete
                        and line.strip() == 'ERROR: EditorSettings not instantiated yet when getting setting "export/android/shutdown_adb_on_exit".'):
                    shutdown_diagnostic = True
                    continue
                raise RuntimeError(f"{step.name} reported an error; see {path}")
            marker_found |= step.marker is not None and line.strip() == step.marker
    if code != 0 or not marker_found:
        raise RuntimeError(f"{step.name} failed (exit {code}, completion marker {marker_found}); see {path}")
    if shutdown_diagnostic:
        print("  Godot 4.8-dev6 logged its known post-export EditorSettings shutdown diagnostic.", flush=True)


def run_step(step, directory, environment, *, cancelled=None):
    path = directory / (step.name + ".log")
    print(f"Checking {step.name}...", flush=True)
    started = time.monotonic()
    with path.open("w") as output:
        process = subprocess.Popen(step.command, cwd=ROOT, env=environment,
                                   stdin=subprocess.DEVNULL, stdout=output, stderr=subprocess.STDOUT,
                                   start_new_session=True)
        try:
            while True:
                if cancelled is not None and cancelled.is_set():
                    raise InterruptedError(f"{step.name} cancelled after another check stopped")
                remaining = step.timeout - (time.monotonic() - started)
                if remaining <= 0:
                    raise subprocess.TimeoutExpired(step.command, step.timeout)
                try:
                    code = process.wait(timeout=min(0.1, remaining))
                    break
                except subprocess.TimeoutExpired:
                    pass
        finally:
            # A live, unreaped session leader pins this command's process group.
            # Never signal the caller, another test or the shared ADB server.
            if process.poll() is None:
                os.killpg(process.pid, signal.SIGTERM)
                try:
                    process.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    os.killpg(process.pid, signal.SIGKILL)
                    process.wait(timeout=5)
    validate(step, code, path)
    print(f"  {step.name}: passed ({time.monotonic() - started:.2f}s)", flush=True)


def build_environment(environment):
    build_path = environment.get("WELD_RUST_BUILD_PATH", environment.get("PATH", ""))
    if not build_path:
        raise RuntimeError("WELD_RUST_BUILD_PATH/PATH must not be empty")
    return dict(environment, PATH=build_path, WELD_RUST_BUILD_PATH=build_path)


def preparation(args, run, environment):
    environment = build_environment(environment)
    started = time.monotonic()
    cache = ROOT / "target/godot-xr-preflight.json"
    run_step(Step("native-build", [str(PROJECT / "scripts/build-gdextension"), "android"], 600), run, environment)
    export_environment = ANDROID_ENV["export_environment"](ROOT, environment)
    key = PREFLIGHT["fingerprint"](ROOT, PROJECT, export_environment)
    if not args.recheck and PREFLIGHT["cache_matches"](cache, key, APK):
        print(f"Preparation cached: inputs and APK unchanged ({time.monotonic() - started:.2f}s). Use --recheck to rerun.", flush=True)
        return
    cache.unlink(missing_ok=True)
    for step in steps():
        run_step(step, run, export_environment)
    if not APK.is_file():
        raise RuntimeError("export did not produce the Pico APK")
    final_key = PREFLIGHT["fingerprint"](ROOT, PROJECT, export_environment)
    if final_key["inputs"] != key["inputs"]:
        raise RuntimeError("XR inputs changed during preparation; rerun before installing")
    PREFLIGHT["save_cache"](cache, final_key, APK)
    print(f"Preparation passed ({time.monotonic() - started:.2f}s); saved successful input/APK fingerprints.", flush=True)


def preparation_lock():
    # Acquisition order is device -> shared preparation. Hold through demo
    # cleanup so another XR workflow cannot compile during timing measurements.
    path = ROOT / "target/godot-xr-preflight.lock"
    path.parent.mkdir(parents=True, exist_ok=True)
    lock = path.open("a+")
    deadline = time.monotonic() + 45
    announced = False
    try:
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return lock
            except BlockingIOError:
                if not announced:
                    print("Another XR workflow is preparing or streaming; waiting up to 45s to avoid build/test interference...", flush=True)
                    announced = True
                if time.monotonic() >= deadline:
                    raise RuntimeError("another XR workflow is still preparing or streaming; stop it before retrying")
                time.sleep(0.1)
    except BaseException:
        lock.close()
        raise


def seconds(value):
    number = int(value)
    if not 1 <= number <= 3600:
        raise argparse.ArgumentTypeError("expected 1..3600 seconds")
    return number


def device_lock(serial):
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
    name = f"weld-xr-{os.getuid()}-{hashlib.sha256(serial.encode()).hexdigest()[:16]}.lock"
    descriptor = os.open(runtime / name, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    lock = os.fdopen(descriptor, "r+")
    deadline = time.monotonic() + 45
    stopped = set()
    try:
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                lock.seek(0)
                try:
                    owner = json.loads(lock.read(4096))
                except ValueError:
                    owner = None
                if isinstance(owner, dict):
                    identity = (owner.get("pid"), owner.get("started"))
                    if all(type(value) is int for value in identity) and identity not in stopped:
                        request_stop(*identity)
                        stopped.add(identity)
                        print("Stopping previous XR run; waiting for its cleanup...", flush=True)
                if time.monotonic() >= deadline:
                    raise RuntimeError("previous XR run did not finish cleanup; no new run started (older helpers may need to be stopped manually)")
                time.sleep(0.05)
        lock.seek(0)
        json.dump({"pid": os.getpid(), "started": process_start(os.getpid())}, lock)
        lock.truncate()
        lock.flush()
    except BaseException:
        lock.close()
        raise
    return lock


def process_start(pid):
    # Field 22 of /proc/PID/stat; the parenthesized command may contain spaces.
    return int(Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[19])


def request_stop(pid, started):
    if pid <= 1 or pid == os.getpid():
        raise RuntimeError("invalid previous XR owner; refusing to signal it")
    try:
        descriptor = os.pidfd_open(pid)
    except ProcessLookupError:
        return
    try:
        # Pin the process before validating its generation. Never signal a
        # recycled PID or use a broad process-name/package kill as a fallback.
        if Path(f"/proc/{pid}").stat().st_uid != os.getuid() or process_start(pid) != started:
            raise RuntimeError("previous XR process identity changed; refusing to signal it")
        signal.pidfd_send_signal(descriptor, signal.SIGTERM)
    except (FileNotFoundError, ProcessLookupError):
        pass  # It exited before the stop request; still wait for the lock.
    finally:
        os.close(descriptor)


def launch_demo(command, environment):
    process = subprocess.Popen(command, env=environment)
    try:
        return process.wait()
    except KeyboardInterrupt:
        # Scope mode runs the existing launcher, whose TERM handler cleans up
        # its device/source. Keep the device lock until that cleanup finishes.
        process.terminate()
        process.wait(timeout=30)
        raise


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--serial", help="Pico ADB serial; otherwise requires exactly one ready device")
    parser.add_argument("--adb", default=os.environ.get("ADB", "adb"), help="shared ADB executable (default: ADB or PATH)")
    parser.add_argument("--app", choices=("blender", "foot", "azahar"), default="blender")
    parser.add_argument("--rom", type=Path, help="game image for --app azahar")
    parser.add_argument("--presentation-rules", type=Path, help="local window selection, stereo and sizing rules")
    parser.add_argument("--codec", choices=("av1", "h264"), default="av1")
    parser.add_argument("--transport", choices=("n0", "adb"), default="n0", help="use USB-only ADB or the normal Iroh network path")
    parser.add_argument("--recheck", action="store_true", help="rerun export even if preparation is cached; does not run tests or linting")
    duration = parser.add_mutually_exclusive_group()
    duration.add_argument("--seconds", type=seconds, default=180)
    duration.add_argument("--no-timeout", dest="seconds", action="store_const", const=None,
                          help="run until interrupted or a demo process exits")
    parser.add_argument("--half-rate", action="store_true", help="test half-rate streaming without changing XR refresh")
    parser.add_argument("--decoder-low-latency", action="store_true",
                        help="test Android's standard low-latency decoder request")
    parser.add_argument("--bitrate-mbps", type=int, default=16,
                        help="positive integer shared encoder target across windows (default: 16 Mbps)")
    args = parser.parse_args(argv)
    if not 1 <= args.bitrate_mbps <= (2**64 - 1) // 1_000_000:
        parser.error("--bitrate-mbps must be positive and fit Weld's 64-bit bits/second target")
    if args.app == "azahar" and (args.rom is None or not args.rom.is_file()):
        parser.error("--app azahar requires --rom pointing to an existing game image")
    if args.rom is not None and args.app != "azahar":
        parser.error("--rom requires --app azahar")
    if args.presentation_rules is not None and not args.presentation_rules.is_file():
        parser.error("presentation rules file does not exist")
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    adb = shutil.which(args.adb)
    if adb is None:
        raise RuntimeError("ADB is missing; enter the development shell or supply --adb")
    environment = dict(os.environ)
    devices = subprocess.check_output([adb, "devices"], text=True, timeout=10, env=environment)
    ready = [line.split()[0] for line in devices.splitlines() if line.endswith("\tdevice")]
    if args.serial is None and len(ready) != 1:
        raise RuntimeError("connect one authorized Pico or pass --serial")
    serial = args.serial or ready[0]
    if serial not in ready:
        raise RuntimeError(f"device {serial} is not ready; reconnect/authorize it before running")
    with device_lock(serial):
        with preparation_lock():
            return workflow(args, adb, serial, environment)


def workflow(args, adb, serial, environment):
    build_path = build_environment(environment)["PATH"]
    for executable in ["cargo", str(ROOT / "scripts/run-godot"), "systemd-run"]:
        path = environment["PATH"] if executable == "systemd-run" else build_path
        if shutil.which(executable, path=path) is None:
            raise RuntimeError(f"missing {executable}; enter the development shell")
    validation = ROOT / "target/validation"
    validation.mkdir(parents=True, exist_ok=True)
    run = Path(tempfile.mkdtemp(prefix="godot-xr-", dir=validation))
    APK.parent.mkdir(parents=True, exist_ok=True)
    print(f"XR preparation: {run}\nADB: {adb}\nDevice: {serial}", flush=True)
    preparation(args, run, environment)
    run_step(Step("install", [adb, "-s", serial, "install", "-r", str(APK)], 120, "Success"), run, environment)
    print("Preparation verified. Starting the XR demo (12 GiB memory limit, no swap).", flush=True)
    # The existing launcher owns demo cleanup, pairing and source supervision.
    command = ["systemd-run", "--user", "--scope", "--quiet", "-p", "MemoryMax=12G", "-p", "MemorySwapMax=0",
               str(ROOT / "scripts/run-godot-hoist"), "--serial", serial, "--app", args.app,
               "--bitrate-mbps", str(args.bitrate_mbps), "--codec", args.codec]
    command.extend(["--transport", args.transport])
    command.extend(["--no-timeout"] if args.seconds is None else ["--seconds", str(args.seconds)])
    if args.half_rate:
        command.append("--half-rate")
    if args.decoder_low_latency:
        command.append("--decoder-low-latency")
    for option, value in [("--rom", getattr(args, "rom", None)), ("--presentation-rules", getattr(args, "presentation_rules", None))]:
        if value is not None:
            command.extend([option, str(value.resolve())])
    demo_environment = dict(environment)
    demo_environment["PATH"] = str(Path(adb).parent) + os.pathsep + environment.get("PATH", "")
    return launch_demo(command, demo_environment)


if __name__ == "__main__":
    def interrupted(_signal, _frame):
        raise KeyboardInterrupt

    for shutdown_signal in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(shutdown_signal, interrupted)
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("XR workflow stopped; cleanup completed.", file=sys.stderr)
        sys.exit(130)
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        print(f"XR preparation failed: {error}", file=sys.stderr)
        sys.exit(1)

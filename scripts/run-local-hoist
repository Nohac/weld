#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repository_root="$(cd -- "${script_dir}/.." && pwd)"
socket_path="${WELD_HOIST_SOCKET:-${repository_root}/target/validation/weld-hoist.sock}"
surface_mode="encoded-opaque"
codec="h264"
codec_selected=false
trace_media=false
dump_encoded=false

while [[ "$#" -gt 0 ]]; do
    case "$1" in
        --native)
            surface_mode="native"
            shift
            ;;
        --trace-media)
            trace_media=true
            shift
            ;;
        --dump-encoded)
            dump_encoded=true
            shift
            ;;
        --codec)
            if [[ "$#" -lt 2 ]]; then
                printf '%s\n' '--codec requires h264 or av1.' >&2
                exit 2
            fi
            codec="$2"
            codec_selected=true
            if [[ "${codec}" != "h264" && "${codec}" != "av1" ]]; then
                printf 'Unsupported codec: %s; expected h264 or av1.\n' "${codec}" >&2
                exit 2
            fi
            shift 2
            ;;
        --)
            shift
            break
            ;;
        *)
            break
            ;;
    esac
done

if [[ "${surface_mode}" == "native" && "${dump_encoded}" == true ]]; then
    printf 'Encoded dumping cannot be combined with --native.\n' >&2
    exit 2
fi
if [[ "${surface_mode}" == "native" && "${codec_selected}" == true ]]; then
    printf '%s\n' '--codec cannot be combined with --native.' >&2
    exit 2
fi

if [[ "${surface_mode}" == "encoded-opaque" ]]; then
    log_label="encoded-${codec}"
else
    log_label="${surface_mode}"
fi
source_log="${repository_root}/target/validation/weld-hoist-source-${log_label}.log"
destination_log="${repository_root}/target/validation/weld-hoist-destination-${log_label}.log"
encoded_dump_run="$(date -u +%Y%m%dT%H%M%SZ)"
encoded_dump_directory="${repository_root}/target/validation/${codec}-${encoded_dump_run}"

if [[ "${trace_media}" == true ]]; then
    media_filter="weld_hoist_local::encoded=trace,weld_media_vaapi=trace"
    if [[ -n "${RUST_LOG:-}" ]]; then
        export RUST_LOG="${RUST_LOG},${media_filter}"
    else
        export RUST_LOG="info,${media_filter}"
    fi
    printf 'Media trace filter: %s\n' "${RUST_LOG}"
fi

if [[ "$#" -eq 0 ]]; then
    source_client=(foot)
else
    source_client=("$@")
fi

mkdir -p -- "$(dirname -- "${socket_path}")"
rm -f -- "${socket_path}"

cd -- "${repository_root}"
printf 'Starting %s local hoist with %s. Focus the source window and press Super+H.\n' \
    "${surface_mode}" "${codec}"
source_options=(
    --backend nested
    --wayland-socket weld-hoist-source
    --hoist-listen "${socket_path}"
    --hoist-surface-mode "${surface_mode}"
)
if [[ "${surface_mode}" == "encoded-opaque" ]]; then
    source_options+=(--hoist-codec "${codec}")
    if [[ "${dump_encoded}" == true ]]; then
        source_options+=(--hoist-encoded-dump-dir "${encoded_dump_directory}")
        printf 'Encoded dump directory: %s\n' "${encoded_dump_directory}"
    fi
fi
cargo run -- "${source_options[@]}" \
    -- "${source_client[@]}" \
    > >(tee "${source_log}") 2>&1 &
source_pid=$!

cleanup() {
    kill -TERM "${source_pid}" "${destination_pid:-}" 2>/dev/null || true
    wait "${source_pid}" "${destination_pid:-}" 2>/dev/null || true
    rm -f -- "${socket_path}"
}
trap cleanup EXIT INT TERM

while [[ ! -S "${socket_path}" ]]; do
    kill -0 "${source_pid}" 2>/dev/null || {
        printf 'Source exited before creating %s\n' "${socket_path}" >&2
        exit 1
    }
    sleep 0.05
done

cargo run -- --backend nested --wayland-socket weld-hoist-destination --hoist-connect "${socket_path}" \
    > >(tee "${destination_log}") 2>&1 &
destination_pid=$!

printf 'Source log: %s\nDestination log: %s\n' "${source_log}" "${destination_log}"
wait "${source_pid}" "${destination_pid}"

#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repository_root="$(cd -- "${script_dir}/.." && pwd)"
codec="av1"
network="direct"
ticket_timeout=120

usage() {
    printf '%s\n' \
        'Usage: scripts/run-iroh-hoist [--codec av1|h264] [--network direct|n0]' \
        '       [--ticket-timeout SECONDS] [-- CLIENT ARGS...]' \
        'Each run exchanges the intended peer identities in a fresh private directory.' \
        'Both endpoints use the current network namespace; this is not the isolated 5G test.'
}

while [[ "$#" -gt 0 ]]; do
    case "$1" in
        --help|-h)
            usage
            exit 0
            ;;
        --codec)
            [[ "$#" -ge 2 ]] || {
                printf '%s\n' '--codec requires av1 or h264.' >&2
                exit 2
            }
            codec="$2"
            [[ "${codec}" == "av1" || "${codec}" == "h264" ]] || {
                printf 'Unsupported codec: %s; expected av1 or h264.\n' "${codec}" >&2
                exit 2
            }
            shift 2
            ;;
        --network)
            [[ "$#" -ge 2 ]] || {
                printf '%s\n' '--network requires direct or n0.' >&2
                exit 2
            }
            network="$2"
            [[ "${network}" == "direct" || "${network}" == "n0" ]] || {
                printf 'Unsupported network: %s; expected direct or n0.\n' "${network}" >&2
                exit 2
            }
            shift 2
            ;;
        --ticket-timeout)
            [[ "$#" -ge 2 && "$2" =~ ^[1-9][0-9]{0,3}$ && "$2" -le 3600 ]] || {
                printf '%s\n' '--ticket-timeout requires 1..3600 seconds.' >&2
                exit 2
            }
            ticket_timeout="$2"
            shift 2
            ;;
        --)
            shift
            break
            ;;
        *)
            break
            ;;
    esac
done

if [[ -n "${WELD_IROH_TICKET+x}" ]]; then
    printf '%s\n' 'WELD_IROH_TICKET is no longer supported; each run needs a fresh private identity exchange.' >&2
    exit 2
fi

if [[ "$#" -eq 0 ]]; then
    source_client=(foot)
else
    source_client=("$@")
fi

validation_directory="${repository_root}/target/validation"
cd -- "${repository_root}"
cargo build --bin weldwm
mkdir -p -- "${validation_directory}"
run_directory=$(mktemp -d "${validation_directory}/iroh-${codec}-${network}.XXXXXX")
ticket_path="${run_directory}/source.ticket"
identity_path="${run_directory}/destination.identity"
source_log="${run_directory}/source.log"
destination_log="${run_directory}/destination.log"
printf '{"codec":"%s","transport":"%s","receiver":"weld","started_at":%s}\n' \
    "${codec}" "${network}" "$(date +%s)" > "${run_directory}/run.json"
export RUST_LOG="${RUST_LOG-info,weld_media_diag=debug,weld_network_diag=debug}"

printf 'Starting encoded Iroh hoist with %s over %s. Focus the source window and press Super+H.\n' \
    "${codec}" "${network}"
started_at=${SECONDS}
cargo run -- \
    --backend nested \
    --wayland-socket weld-iroh-source \
    --hoist-iroh-listen "${ticket_path}" \
    --hoist-iroh-expect-peer "${identity_path}" \
    --hoist-iroh-timeout "${ticket_timeout}" \
    --hoist-iroh-network "${network}" \
    --hoist-codec "${codec}" \
    -- "${source_client[@]}" \
    > >(tee "${source_log}") 2>&1 &
source_pid=$!

cleanup() {
    kill -TERM "${source_pid}" "${destination_pid:-}" 2>/dev/null || true
    wait "${source_pid}" "${destination_pid:-}" 2>/dev/null || true
    rm -f -- "${ticket_path}" "${identity_path}"
}
trap cleanup EXIT INT TERM

while [[ ! -s "${ticket_path}" ]]; do
    kill -0 "${source_pid}" 2>/dev/null || {
        printf 'Source exited before publishing %s\n' "${ticket_path}" >&2
        exit 1
    }
    if (( SECONDS - started_at >= ticket_timeout )); then
        printf 'Timed out waiting for Iroh ticket %s\n' "${ticket_path}" >&2
        exit 1
    fi
    sleep 0.05
done

cargo run -- \
    --backend nested \
    --wayland-socket weld-iroh-destination \
    --hoist-iroh-connect "${ticket_path}" \
    --hoist-iroh-publish-identity "${identity_path}" \
    --hoist-iroh-timeout "${ticket_timeout}" \
    --hoist-iroh-network "${network}" \
    > >(tee "${destination_log}") 2>&1 &
destination_pid=$!

printf 'Source log: %s\nDestination log: %s\n' "${source_log}" "${destination_log}"
wait "${source_pid}" "${destination_pid}"

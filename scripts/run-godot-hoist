#!/usr/bin/env python3
"""Pair a development Godot viewer with headless encoded windows over Iroh N0.

The phone must already have the current debug APK installed. Only public files
are exchanged; private keys remain in per-device storage outside build outputs.
"""
import argparse
import json
import ipaddress
import os
from pathlib import Path
import re
import resource
import runpy
import signal
import subprocess
import tempfile
import time

ROOT = Path(__file__).resolve().parent.parent
LAUNCHER = runpy.run_path(str(ROOT / "scripts/run-headless-iroh-hoist"))
PACKAGE = "com.example.weldvr"
LogCapture = runpy.run_path(str(ROOT / "scripts/godot-log-capture.py"))["LogCapture"]
APP_DIRECTORY = "files/weld-device"
HALF_RATE_MARKER = "diagnostic-half-rate"
LOW_LATENCY_MARKER = "diagnostic-low-latency"
ReverseTunnel = runpy.run_path(str(ROOT / "scripts/adb-reverse.py"))["ReverseTunnel"]


def prepare_presentation_rules(path, directory=None, adb=None):
    text = None
    if path is not None:
        with path.open("rb") as source:
            data = source.read(4097)
        if len(data) > 4096:
            raise RuntimeError("presentation rules exceed 4096 bytes")
        text = data.decode("utf-8")
    if adb is not None:
        subprocess.run([*adb, "shell", "run-as", PACKAGE, "mkdir", "-p", APP_DIRECTORY], check=True, timeout=5)
        if text is None:
            subprocess.run([*adb, "shell", "run-as", PACKAGE, "rm", "-f", f"{APP_DIRECTORY}/presentation.rules"], check=True, timeout=5)
        else:
            subprocess.run([*adb, "shell", "run-as", PACKAGE, "sh", "-c",
                "'umask 077; cat > files/weld-device/presentation.rules'"], input=text, text=True, check=True, timeout=5)
    else:
        target = directory / "presentation.rules"
        if text is None:
            target.unlink(missing_ok=True)
        else:
            target.write_text(text)


def prepare_cadence_test(half_rate, directory=None, adb=None):
    prepare_diagnostic_marker(HALF_RATE_MARKER, half_rate, directory, adb)


def prepare_decoder_test(low_latency, directory=None, adb=None):
    prepare_diagnostic_marker(LOW_LATENCY_MARKER, low_latency, directory, adb)


def prepare_diagnostic_marker(name, enabled, directory=None, adb=None):
    # Consumed once by the receiver, not a persistent pairing/preference change.
    if adb is not None:
        subprocess.run([*adb, "shell", "run-as", PACKAGE, "mkdir", "-p", APP_DIRECTORY],
                       check=True, timeout=5)
        operation = ["touch"] if enabled else ["rm", "-f"]
        subprocess.run([*adb, "shell", "run-as", PACKAGE, *operation,
                        f"{APP_DIRECTORY}/{name}"], check=True, timeout=5)
    else:
        marker = directory / name
        if enabled:
            marker.touch(mode=0o600)
        else:
            marker.unlink(missing_ok=True)


def identity(text):
    value = text.strip()
    if not re.fullmatch(r"[0-9a-f]{64}", value):
        raise RuntimeError("expected one canonical public Iroh identity")
    return value


def profile_peer(text):
    if len(text.encode()) > 4096:
        raise RuntimeError("profile exceeds 4096 bytes")
    peers = [line.split("=", 1)[1].strip() for line in text.splitlines()
             if line.partition("=")[0].strip() == "peer"]
    if len(peers) != 1:
        raise RuntimeError("profile must pin exactly one peer")
    return identity(peers[0])


def check_existing(existing, new):
    if existing and profile_peer(existing) != profile_peer(new):
        raise RuntimeError("viewer is paired with a different source; refusing silent re-enrollment")


def write_new(path, text):
    with os.fdopen(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "w") as output:
        output.write(text)


def source_command(exchange, state, app, bitrate_mbps=16, codec="av1", gamepad=False, transport="n0"):
    return ["cargo", "run", "--locked", "--quiet", "--", "--backend", "headless",
            "--wayland-socket", "source", "--hoist-all", "--headless-window-size", "960x640",
            "--keyboard-repeat-mode", "compositor", "--legacy-key-repeat", "emulated",
            "--hoist-iroh-listen", str(exchange / "source.ticket"),
            "--hoist-iroh-expect-peer", str(exchange / "viewer.identity"),
            "--hoist-iroh-device-dir", str(state / "source"),
            "--hoist-iroh-publish-profile", str(exchange / "source.profile"),
            *(["--hoist-iroh-adb-listen", "127.0.0.1:0"] if transport == "adb" else ["--hoist-iroh-network", "n0"]), "--hoist-codec", codec,
            "--hoist-bitrate-target-mbps", str(bitrate_mbps),
            *(["--hoist-gamepad"] if gamepad else []), "--", *app]


def adb_profile_port(profile):
    profile_peer(profile)
    fields = [line.split("=", 1) for line in profile.splitlines() if line.strip()]
    networks = [value for key, value in fields if key == "network"]
    addresses = [value for key, value in fields if key == "address"]
    if networks != ["adb"] or len(addresses) != 1:
        raise RuntimeError("source did not publish a single ADB TCP address")
    host, _, port = addresses[0].rpartition(":")
    if not ipaddress.ip_address(host.strip("[]")).is_loopback or not port.isdecimal() or not 0 < int(port) < 65536:
        raise RuntimeError("ADB profile target is not nonzero loopback TCP")
    return int(port)


def device_adb_profile(profile, port):
    adb_profile_port(profile)
    return "\n".join(f"address=127.0.0.1:{port}" if line.startswith("address=") else line
                     for line in profile.splitlines()) + "\n"


def close_source_for_restart(hosts):
    # Keep ownership until close succeeds so finally can retry a failed close.
    hosts[0].close()
    hosts.pop(0)


def viewer_process(adb):
    # Saved identity files can exist before Android starts a fresh process.
    # XR launch prompts can also delay activity/process creation.
    result = subprocess.run([*adb, "shell", "pidof", PACKAGE],
                            text=True, capture_output=True, timeout=5)
    if result.returncode == 1 and not result.stdout.strip():
        return None
    result.check_returncode()
    pid = result.stdout.strip()
    if not re.fullmatch(r"[0-9]+", pid):
        raise RuntimeError("expected one Weld VR process")
    return pid


def stop_owned(hosts, stop_viewer=None):
    failures = []
    operations = [(host.role, host.close) for host in reversed(hosts)]
    if stop_viewer is not None:
        operations.insert(0, ("phone viewer", stop_viewer))
    for role, operation in operations:
        try:
            operation()
        except (OSError, RuntimeError, subprocess.SubprocessError) as error:
            failures.append(f"{role}: {error}")
    if failures:
        raise RuntimeError("Cleanup incomplete; processes may remain: " + "; ".join(failures))


def parse_arguments(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--serial", help="ADB serial; otherwise requires exactly one authorized device")
    parser.add_argument("--desktop", action="store_true", help="run the same Godot viewer on this laptop")
    parser.add_argument("--transport", choices=("n0", "adb"), default="n0",
                        help="adb: USB-only tunnel; with --desktop, custom-transport loopback without USB")
    parser.add_argument("--half-rate", action="store_true",
                        help="diagnostic: request half the display rate; keep XR and receiver buffering unchanged")
    parser.add_argument("--decoder-low-latency", action="store_true",
                        help="diagnostic: request Android decoder low-latency mode; requires the patched APK")
    parser.add_argument("--state-dir", type=Path, help="private persistent device state, not a build directory")
    duration = parser.add_mutually_exclusive_group()
    duration.add_argument("--seconds", type=LAUNCHER["positive_seconds"], default=120)
    duration.add_argument("--no-timeout", dest="seconds", action="store_const", const=None,
                          help="run until interrupted or a test process exits; keep summary diagnostics enabled")
    parser.add_argument("--restart-after", type=LAUNCHER["positive_seconds"],
                        help="diagnostic: restart the source/apps once, leaving the viewer alive")
    parser.add_argument("--app", choices=("foot", "blender", "azahar"), default="foot")
    parser.add_argument("--rom", type=Path, help="game image for --app azahar")
    parser.add_argument("--presentation-rules", type=Path, help="local window selection, stereo and sizing rules")
    parser.add_argument("--codec", choices=("av1", "h264"), default="av1")
    parser.add_argument("--blender-script", type=Path,
                        help="diagnostic: run a Python exercise in a factory-startup Blender instance")
    parser.add_argument("--bitrate-mbps", type=int, default=16,
                        help="positive integer shared encoder target across windows (default: 16 Mbps)")
    args = parser.parse_args(argv)
    if not 1 <= args.bitrate_mbps <= (2**64 - 1) // 1_000_000:
        parser.error("--bitrate-mbps must be positive and fit Weld's 64-bit bits/second target")
    if args.transport == "adb" and args.restart_after is not None:
        parser.error("--restart-after uses N0 rediscovery; ADB would require updating its ephemeral tunnel target")
    if args.app == "azahar" and (args.rom is None or not args.rom.is_file()):
        parser.error("--app azahar requires --rom pointing to an existing game image")
    if args.rom is not None:
        if args.app != "azahar":
            parser.error("--rom requires --app azahar")
        args.rom = args.rom.resolve()
    if args.presentation_rules is not None and not args.presentation_rules.is_file():
        parser.error("presentation rules file does not exist")
    if args.desktop and args.decoder_low_latency:
        parser.error("--decoder-low-latency requires an Android viewer")
    if args.blender_script is not None:
        if args.app != "blender" or not args.blender_script.is_file():
            parser.error("--blender-script requires --app blender and an existing Python file")
        args.blender_script = args.blender_script.resolve()
    return args


def app_command(args):
    if args.app == "azahar":
        return ["azahar", "--windowed", str(args.rom)]
    if args.app == "foot":
        return ["foot", "-e", "htop"]
    if args.blender_script is not None:
        return ["blender", "--factory-startup", "--python", str(args.blender_script)]
    return ["blender"]


def diagnostic_environment():
    environment = os.environ.copy()
    selected = environment.get("RUST_LOG", "info")
    for target in ("weld_media_diag", "weld_vr_diag", "weld_network_diag"):
        if not any(part.strip().startswith(target + "=") for part in selected.split(",")):
            selected += "," + target + "=debug"
    environment["RUST_LOG"] = selected
    return environment


def source_environment(runtime):
    environment = diagnostic_environment()
    host_runtime = environment.get("XDG_RUNTIME_DIR")
    if host_runtime:
        # Isolate the Wayland socket, not host audio. Preserve explicit audio
        # overrides and client.conf server selection rather than forcing a sink.
        environment.setdefault("PIPEWIRE_RUNTIME_DIR", host_runtime)
        environment.setdefault("PULSE_RUNTIME_PATH", str(Path(host_runtime) / "pulse"))
    for key in ("DISPLAY", "WAYLAND_DISPLAY", "WAYLAND_SOCKET"):
        environment.pop(key, None)
    environment["XDG_RUNTIME_DIR"] = str(runtime)
    return environment


def main(argv=None):
    args = parse_arguments(argv)
    os.umask(0o077)
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    state = args.state_dir or Path(os.environ.get("XDG_DATA_HOME", str(Path.home() / ".local/share"))) / "weld/godot-hoist"
    state = state.resolve()
    state.mkdir(parents=True, mode=0o700, exist_ok=True)
    if state.stat().st_mode & 0o777 != 0o700 or state.stat().st_uid != os.geteuid():
        raise RuntimeError("state directory must be current-user-owned mode 0700")
    adb = None
    if not args.desktop:
        serial = args.serial
        if not serial:
            devices = subprocess.check_output(["adb", "devices"], text=True, timeout=5)
            ready = [line.split()[0] for line in devices.splitlines() if line.endswith("\tdevice")]
            if len(ready) != 1:
                raise RuntimeError("connect one unlocked USB-debugging device, or use --serial")
            serial = ready[0]
        adb = ["adb", "-s", serial]
        subprocess.run([*adb, "shell", "run-as", PACKAGE, "pwd"], check=True, stdout=subprocess.DEVNULL, timeout=5)
    print(f"Live {args.codec.upper()} window hierarchy; receiver limits are eight surfaces/layers and 32 in-flight images.", flush=True)
    print(f"Shared {args.codec.upper()} bitrate target: {args.bitrate_mbps} Mbps (not a bandwidth cap).", flush=True)
    print(f"Stream cadence: {'half' if args.half_rate else 'full'} display rate; local presentation unchanged.", flush=True)
    print(f"Android decoder low-latency request: {args.decoder_low_latency} (device support is not guaranteed).", flush=True)
    if args.transport == "adb":
        print("Iroh custom TCP loopback (no USB)." if args.desktop else "Iroh over ADB USB only; no IP/discovery/relay fallback.", flush=True)
    else:
        print("Iroh N0 contacts Internet discovery/relay services; existing desktop apps and host routes are unchanged.", flush=True)
    if not args.desktop and args.transport == "n0":
        print("Android development viewer uses public DNS (Google plus Iroh public fallbacks), not system/Private DNS.", flush=True)
    print(f"Persistent device state: {state}", flush=True)
    subprocess.run(["cargo", "build", "--locked", "--bin", "weldwm", "-j2"], cwd=ROOT, check=True)
    if args.desktop:
        subprocess.run([str(ROOT / "apps/weld-vr/scripts/build-gdextension"), "desktop"], check=True)
    validation = ROOT / "target/validation"
    validation.mkdir(parents=True, exist_ok=True)
    run = Path(tempfile.mkdtemp(prefix="godot-hoist-", dir=validation))
    runtime = run / "runtime"
    runtime.mkdir(mode=0o700)
    receiver_directory = state / "desktop-viewer"
    stopping = False
    hosts = []
    app_started = False
    phone_pid = None
    capture = None
    tunnel = ReverseTunnel(adb) if adb is not None and args.transport == "adb" else None
    (run / "run.json").write_text(json.dumps({"started_at": time.time(), "desktop": args.desktop,
        "codec": args.codec, "bitrate_mbps": args.bitrate_mbps, "half_rate": args.half_rate,
        "decoder_low_latency": args.decoder_low_latency,
        "transport": "adb-loopback" if args.desktop and args.transport == "adb" else args.transport,
        "log_capture": "desktop" if args.desktop else "full-run-filtered",
        "clock_note": "Cross-device wall clocks are approximate; timings are local, not one-way latency."}) + "\n")

    def stop(_signal, _frame):
        nonlocal stopping
        stopping = True

    previous = {sig: signal.signal(sig, stop) for sig in LAUNCHER["SHUTDOWN_SIGNALS"]}

    def check():
        if stopping:
            raise InterruptedError("test cancelled")
        if any(host.exited() for host in hosts):
            raise RuntimeError(f"test process exited; see {run}")
        if capture is not None:
            capture.check()

    def wait(predicate, seconds=60):
        deadline = time.monotonic() + seconds
        while True:
            check()
            result = predicate()
            if result:
                return result
            if time.monotonic() >= deadline:
                raise RuntimeError(f"startup timed out; deploy the current debug APK and inspect {run}")
            time.sleep(0.1)

    def phone_read(name):
        # shell v2 preserves remote exit status; exec-out may return an error
        # diagnostic as successful stdout when the not-yet-created file is absent.
        result = subprocess.run([*adb, "shell", "-T", "run-as", PACKAGE, "head", "-c", "4097", f"{APP_DIRECTORY}/{name}"],
                                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=5)
        if result.returncode:
            return None
        if len(result.stdout.encode()) > 4096:
            raise RuntimeError("phone public file exceeds bound")
        return result.stdout

    def phone_install(profile):
        # Fixed destination; stdin contains only the bounded public profile.
        install = "umask 077; p=$(mktemp files/weld-device/.profile.XXXXXX) || exit; cat >\"$p\" && chmod 600 \"$p\" && mv \"$p\" files/weld-device/source.profile; result=$?; rm -f \"$p\"; exit $result"
        subprocess.run([*adb, "shell", "run-as", PACKAGE, "sh", "-c", "'" + install + "'"], input=profile, text=True, check=True, timeout=5)

    print(f"Logs: {run}", flush=True)
    try:
        environment = source_environment(runtime)
        app = app_command(args)
        command = source_command(run, state, app, args.bitrate_mbps, args.codec, gamepad=args.app == "azahar", transport=args.transport)
        if args.app == "azahar":
            print("Gamepad enabled: window gamepad button captures both XR controllers; hold left grip to exit. The virtual controller is visible to host applications.", flush=True)
        hosts.append(LAUNCHER["OwnedHost"]("source", command, environment, ROOT, run))
        wait(lambda: (run / "source.profile").exists())
        profile = (run / "source.profile").read_text()
        profile_peer(profile)
        if tunnel is not None:
            profile = device_adb_profile(profile, tunnel.open(adb_profile_port(profile)))
            check()
        if args.desktop:
            receiver_directory.mkdir(mode=0o700, exist_ok=True)
            profile_path = receiver_directory / "source.profile"
            check_existing(profile_path.read_text() if profile_path.exists() else None, profile)
            temporary = receiver_directory / f"profile-{os.getpid()}.pending"
            write_new(temporary, profile)
            temporary.replace(profile_path)
            prepare_cadence_test(args.half_rate, directory=receiver_directory)
            prepare_presentation_rules(args.presentation_rules, directory=receiver_directory)
            environment = {**diagnostic_environment(), "WELD_VR_DEVICE_DIR": str(receiver_directory)}
            hosts.append(LAUNCHER["OwnedHost"]("viewer",
                [str(ROOT / "scripts/run-godot"), "--path", str(ROOT / "apps/weld-vr"), "--display-driver", "wayland", "--rendering-driver", "opengl3_es"],
                environment, ROOT, run))
            wait(lambda: (receiver_directory / "public.identity").exists())
            public = (receiver_directory / "public.identity").read_text()
        else:
            existing = phone_read("source.profile")
            check_existing(existing, profile)
            # A fresh app process reads one pinned profile. Stop only this test app.
            subprocess.run([*adb, "shell", "am", "force-stop", PACKAGE], check=True, timeout=5)
            prepare_cadence_test(args.half_rate, adb=adb)
            prepare_decoder_test(args.decoder_low_latency, adb=adb)
            prepare_presentation_rules(args.presentation_rules, adb=adb)
            capture = LogCapture(adb, run / "viewer.log")
            if existing is not None:
                phone_install(profile)
            activity = subprocess.check_output([*adb, "shell", "cmd", "package", "resolve-activity", "--brief", PACKAGE], text=True, timeout=5).splitlines()[-1].strip()
            if not activity.startswith(PACKAGE + "/"):
                raise RuntimeError("could not resolve Weld VR activity")
            subprocess.run([*adb, "shell", "am", "start", "-n", activity], check=True, stdout=subprocess.DEVNULL, timeout=10)
            app_started = True
            wait(lambda: phone_read("public.identity") is not None)
            phone_pid = wait(lambda: viewer_process(adb))
            public = phone_read("public.identity")
            # App owns this directory/key. The fixed command installs PUBLIC data
            # only, atomically and with explicit private permissions.
            if existing is None:
                phone_install(profile)
        write_new(run / "viewer.identity", identity(public) + "\n")
        duration = "No runtime timeout" if args.seconds is None else f"Run for {args.seconds}s"
        print(f"Viewer approved. {duration}; Ctrl+C stops the demo. Desktop: click the image for mouse/keyboard input. XR: A left-click, B right-click, trigger middle-click, grip move, stick scroll; flat phone is view-only.", flush=True)
        deadline = None if args.seconds is None else time.monotonic() + args.seconds
        restart_at = time.monotonic() + args.restart_after if args.restart_after else None
        while not stopping and (deadline is None or time.monotonic() < deadline):
            check()
            if restart_at is not None and time.monotonic() >= restart_at:
                print("Restarting source/apps with the same identity; viewer stays alive.", flush=True)
                close_source_for_restart(hosts)
                restart = run / "restart"
                restart.mkdir(mode=0o700)
                (restart / "runtime").mkdir(mode=0o700)
                write_new(restart / "viewer.identity", identity(public) + "\n")
                restart_environment = source_environment(restart / "runtime")
                hosts.insert(0, LAUNCHER["OwnedHost"]("source", source_command(restart, state, app, args.bitrate_mbps, args.codec, gamepad=args.app == "azahar"), restart_environment, ROOT, restart))
                restart_at = None
            time.sleep(0.1)
    except InterruptedError:
        print("Test cancelled.", flush=True)
    finally:
        try:
            if capture is not None:
                capture.close()
        finally:
            try:
                def stop_viewer():
                    try:
                        if app_started:
                            subprocess.run([*adb, "shell", "am", "force-stop", PACKAGE], timeout=5, check=True)
                    finally:
                        # A failed startup may not have consumed the one-shot marker.
                        prepare_decoder_test(False, adb=adb)
                        prepare_presentation_rules(None, adb=adb)
                try:
                    stop_owned(hosts, stop_viewer if adb is not None else None)
                finally:
                    if tunnel is not None:
                        tunnel.close()
            finally:
                for sig, handler in previous.items():
                    signal.signal(sig, handler)
        print("Test processes stopped; device identities and public pairing retained.", flush=True)


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        raise SystemExit(str(error)) from error

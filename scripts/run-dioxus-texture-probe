#!/usr/bin/env python3
"""Build an isolated Dioxus Native/GLES decoder-import APK and optionally launch it."""
import argparse
import os
from pathlib import Path
import shutil
import subprocess
import zipfile

ROOT = Path(__file__).resolve().parent.parent
PROJECT = ROOT / "tools/dioxus-texture-probe"
OUTPUT = ROOT / "target/dioxus-texture-probe"
PACKAGE = "org.weld.dioxusprobe"


def run(*args, **kwargs):
    subprocess.run([str(arg) for arg in args], check=True, **kwargs)


def main():
    os.umask(0o077)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--install", action="store_true")
    parser.add_argument("--serial", help="ADB device serial (required when multiple devices are connected)")
    parser.add_argument("--jobs", type=int, default=8)
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args()
    if args.jobs < 1:
        parser.error("--jobs must be positive")
    OUTPUT.mkdir(parents=True, exist_ok=True)
    sdk = Path(os.environ.get("ANDROID_HOME") or os.environ["ANDROID_SDK_ROOT"])
    ndk = Path(os.environ.get("ANDROID_NDK_HOME") or os.environ["ANDROID_NDK_ROOT"])
    run(ROOT / "scripts/build-android-ffmpeg")
    prefix = Path(subprocess.check_output(
        [str(ROOT / "scripts/build-android-ffmpeg"), "--print-prefix"], text=True).strip())
    toolchain = ndk / "toolchains/llvm/prebuilt/linux-x86_64"
    env = dict(os.environ, CARGO_TARGET_DIR=str(OUTPUT / "cargo"), FFMPEG_DIR=str(prefix),
               PKG_CONFIG_LIBDIR="", PKG_CONFIG_PATH="",
               BINDGEN_EXTRA_CLANG_ARGS_aarch64_linux_android=
               f"--sysroot={toolchain}/sysroot --target=aarch64-linux-android28")
    run("cargo", "ndk", "-t", "arm64-v8a", "--platform", "28",
        "check" if args.check else "build", "--lib", "--locked", "--manifest-path", PROJECT / "Cargo.toml",
        "-j", args.jobs, env=env, cwd=ROOT)
    if args.check:
        return
    build_tools = sdk / "build-tools/36.1.0"
    apk = OUTPUT / "unsigned.apk"
    run(build_tools / "aapt2", "link", "--manifest", PROJECT / "AndroidManifest.xml",
        "-I", sdk / "platforms/android-36/android.jar", "--min-sdk-version", "28",
        "--target-sdk-version", "36", "-o", apk)
    library = OUTPUT / "cargo/aarch64-linux-android/debug/libweld_dioxus_texture_probe.so"
    stripped = OUTPUT / library.name
    shutil.copy2(library, stripped)
    run(toolchain / "bin/llvm-strip", "--strip-debug", stripped)
    with zipfile.ZipFile(apk, "a", compression=zipfile.ZIP_STORED) as output:
        for lib in [stripped, *(prefix / f"lib/lib{name}.so" for name in ("avcodec", "avformat", "avutil"))]:
            output.write(lib, f"lib/arm64-v8a/{lib.name}")
        output.write(PROJECT / "wrap.sh", "lib/arm64-v8a/wrap.sh")
    aligned = OUTPUT / "aligned.apk"
    run(build_tools / "zipalign", "-f", "-P", "16", "4", apk, aligned)
    key = OUTPUT / "debug.keystore"
    if not key.exists():
        run("keytool", "-genkeypair", "-keystore", key, "-storepass", "android",
            "-keypass", "android", "-alias", "androiddebugkey", "-keyalg", "RSA",
            "-keysize", "2048", "-validity", "10000", "-dname", "CN=Weld Probe")
    signed = OUTPUT / "weld-dioxus-probe.apk"
    run(build_tools / "apksigner", "sign", "--ks", key, "--ks-pass", "pass:android",
        "--out", signed, aligned)
    run(build_tools / "apksigner", "verify", signed)
    print(f"Probe APK: {signed}", flush=True)
    if args.install:
        adb = ["adb", *(["-s", args.serial] if args.serial else [])]
        # Streamed installation extracts wrap.sh, which sets the GLES backend.
        run(*adb, "install", "--no-incremental", "-r", signed)
        run(*adb, "shell", "am", "force-stop", PACKAGE)
        run(*adb, "shell", "am", "start", "-n", PACKAGE + "/android.app.NativeActivity")


if __name__ == "__main__":
    main()

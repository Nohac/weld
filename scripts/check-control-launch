#!/usr/bin/env python3
"""Validate native launch and window CLI/RPC/MCP in a private Weld session."""

import argparse
import concurrent.futures
import base64
import json
import os
from pathlib import Path
import resource
import select
import signal
import socket
import subprocess
import sys
import tempfile
import time
import tty


def wait_for(host, predicate, description, seconds=20):
    deadline = time.monotonic() + seconds
    while not predicate():
        if host.poll() is not None or time.monotonic() >= deadline:
            raise RuntimeError(f"timed out waiting for {description}")
        time.sleep(0.05)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--nested", action="store_true")
    parser.add_argument("--xwayland", action="store_true")
    parser.add_argument("--no-build", action="store_true")
    parser.add_argument("--attributed", action="store_true", help="Test workspace attribution and headless control/peek (requires --nested)")
    parser.add_argument("--accessibility-app", metavar="ZENITY", help="Validate AT-SPI with this Zenity executable (requires --nested)")
    parser.add_argument("--text-app", metavar="ZENITY", help="Validate Unicode typing in a GTK entry on Wayland and, with --xwayland, X11")
    args = parser.parse_args()
    if args.attributed and not args.nested:
        parser.error("--attributed requires --nested")
    if args.accessibility_app and not args.nested:
        parser.error("--accessibility-app requires --nested")
    if args.text_app and not args.nested:
        parser.error("--text-app requires --nested")
    root = Path(__file__).resolve().parent.parent
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    if not args.no_build:
        subprocess.run(["cargo", "build", "--locked", "-j8", "-p", "weldwm", "-p", "weld-control", "--bins"], cwd=root, check=True)
        if not args.nested:
            subprocess.run(["cargo", "build", "--locked", "-j8", "-p", "weldwm", "-p", "weld-core", "--example", "wayland_session_probe"], cwd=root, check=True)
        if args.xwayland:
            subprocess.run(["cargo", "build", "--locked", "-j8", "-p", "weldwm", "-p", "weld-core", "--example", "x11_window_probe"], cwd=root, check=True)
    validation = root / "target/validation"
    validation.mkdir(exist_ok=True)
    run = Path(tempfile.mkdtemp(prefix="control-launch-", dir=validation))
    display = run / "wayland"
    control = run / "weld-control/wayland.sock"
    config = run / "test.config"
    config.write_text("font monospace 14\ndefault_border pixel 2\ninput * {\n xkb_options ctrl:swapcaps\n}\n")
    environment = dict(os.environ, RUST_LOG="info")
    if not args.nested:
        environment["VK_DRIVER_FILES"] = str(run / "absent-vulkan-driver.json")
        environment["VK_ICD_FILENAMES"] = environment["VK_DRIVER_FILES"]
    options = ["--backend", "nested", "--config", str(config)] if args.nested else [
        "--backend", "headless", "--headless-output", "640x480", "--scale", "1.5",
    ]
    if args.xwayland:
        options.append("--xwayland")
    command = [str(root / "target/debug/weldwm"), *options, "--wayland-socket", str(display)]
    print(f"Logs: {run}", flush=True)
    with (run / "host.log").open("w") as log:
        host = subprocess.Popen(command, cwd=root, env=environment, stdout=log,
                                stderr=subprocess.STDOUT, start_new_session=True)
        try:
            wait_for(host, lambda: control.exists() and display.exists(), "host sockets", seconds=45)
            ctl = [str(root / "target/debug/weldctl"), "--session", str(display)]
            failed = subprocess.run([*ctl, "launch", "--", "/weld-probe-missing-executable"],
                                    capture_output=True, text=True, timeout=10)
            if failed.returncode == 0 or "failed to spawn" not in failed.stderr:
                raise RuntimeError(f"missing executable did not return spawn failure: {failed}")
            bad_directory = subprocess.run([*ctl, "launch", "--cwd", str(run / "absent-directory"), "--", sys.executable],
                                           capture_output=True, text=True, timeout=10)
            if bad_directory.returncode == 0 or "failed to spawn" not in bad_directory.stderr:
                raise RuntimeError(f"missing directory did not return spawn failure: {bad_directory}")
            assert not list(run.glob("weld-run-*")), "failed launch retained its socket"
            mode = "nested" if args.nested else "headless"
            output = subprocess.check_output([
                *ctl, "launch", "--cwd", str(run), "--", sys.executable,
                str(Path(__file__).resolve()), "--child", mode,
                "argument with spaces", "$(literal); untouched",
            ], text=True, timeout=10)
            wait_for(host, lambda: (run / "child.json").exists(), "launched child")
            child = json.loads((run / "child.json").read_text())
            assert str(child["pid"]) in output, (child, output)
            assert child["cwd"] == str(run), child
            assert child["argv"] == ["argument with spaces", "$(literal); untouched"], child
            assert Path(child["environment"]["WAYLAND_DISPLAY"]).parent == display.parent, child
            assert child["environment"]["WAYLAND_DISPLAY"] != str(display), child
            assert Path(child["environment"]["WAYLAND_DISPLAY"]).stat().st_mode & 0o777 == 0o600
            assert child["environment"]["WELD_SESSION"] == str(display), child
            assert "WAYLAND_SOCKET" not in child["environment"], child
            assert "DISPLAY" not in child["environment"], child
            print("PASS exact arguments, working directory, display routing and failure recovery", flush=True)
            if args.nested:
                ipc = child["environment"]["SWAYSOCK"]
                def mapped(name):
                    tree = subprocess.check_output(["swaymsg", "-s", ipc, "-t", "get_tree", "-r"], text=True, timeout=5)
                    return name in tree
                wait_for(host, lambda: mapped("weld-launch-probe"), "Foot admission through native launch")
                if args.attributed:
                    check_attributed(ctl, control, host, run)
                else:
                    check_windows(ctl, control, host, run, display, args.accessibility_app, args.text_app, args.xwayland)
                if args.xwayland:
                    subprocess.run([*ctl, "launch", "--shared-display", "--", str(root / "target/debug/examples/x11_window_probe"),
                                    "--seconds", "2", "--title", "Weld X11 launch probe"], check=True, timeout=10)
                    wait_for(host, lambda: mapped("Weld X11 launch probe"), "X11 admission through native launch")
                    wait_for(host, lambda: "X11_PROBE_DONE" in (run / "host.log").read_text(), "X11 probe completion")
                print("PASS native window admission and session IPC environment", flush=True)
            else:
                wait_for(host, lambda: "PASS dormant" in (run / "host.log").read_text(), "Wayland protocol probe")
                print("PASS headless Wayland configure, buffer release and dormant frame demand", flush=True)
            os.killpg(host.pid, signal.SIGTERM)
            if host.wait(timeout=10) != 0:
                raise RuntimeError("host shutdown failed")
            assert not control.exists(), "control socket survived shutdown"
            assert not list(run.glob("weld-run-*")), "launch socket survived shutdown"
            if args.xwayland and display.exists():
                with socket.socket(socket.AF_UNIX) as connection:
                    connection.settimeout(1)
                    assert connection.connect_ex(str(display)) != 0, "Wayland endpoint still listening"
                print("WARNING XWayland teardown left a stale Wayland socket file (existing host lifecycle issue)", flush=True)
            else:
                assert not display.exists(), "Wayland socket survived shutdown"
            print("PASS host shutdown and control socket cleanup", flush=True)
        finally:
            # This runner owns this process group, including all RPC-launched children.
            try:
                os.killpg(host.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            try:
                host.wait(timeout=5)
            except subprocess.TimeoutExpired:
                os.killpg(host.pid, signal.SIGKILL)
                host.wait(timeout=5)


def window_rpc(control, method, params):
    with socket.socket(socket.AF_UNIX) as connection:
        connection.settimeout(10)
        connection.connect(str(control))
        body = json.dumps({"Window": {"jsonrpc": "2.0", "id": "validation", "method": method, "params": params}}).encode()
        connection.sendall(len(body).to_bytes(4, "little") + body)
        def exact(length):
            data = bytearray()
            while len(data) < length:
                chunk = connection.recv(length - len(data))
                if not chunk:
                    raise RuntimeError("window RPC disconnected before reply")
                data.extend(chunk)
            return data
        length = int.from_bytes(exact(4), "little")
        assert length <= 16 * 1024 * 1024
        response = json.loads(exact(length))["Window"]
        assert response["id"] == "validation", response
        return response


def check_attributed(ctl, control, host, run):
    def invoke(method, **params):
        result = window_rpc(control, method, params)
        assert "result" in result, result
        return result["result"]
    def windows():
        return invoke("list")["windows"]
    def launch(*arguments):
        return json.loads(subprocess.check_output([*ctl, "run", *arguments], text=True, timeout=10))
    original = next(window for window in windows() if window["app_id"] == "weld-launch-probe")
    # The launcher exits before its descendant connects to the inherited endpoint.
    delayed = "import subprocess,sys; subprocess.Popen([sys.executable,'-c',\"import time,os; time.sleep(2); os.execvp('foot',['foot','--app-id=weld-delayed-probe'])\"])"
    receipt = launch("--workspace", "3", "--owner", "validation", "--", sys.executable, "-c", delayed)
    wait_for(host, lambda: any(window["app_id"] == "weld-delayed-probe" for window in windows()), "delayed attributed window")
    delayed_window = next(window for window in windows() if window["app_id"] == "weld-delayed-probe")
    assert delayed_window["workspace"] != original["workspace"], delayed_window
    assert not delayed_window["visible"] and not delayed_window["focused"], delayed_window
    assert delayed_window["launch_id"] == receipt["launch_id"], delayed_window
    assert len(invoke("find", owner="validation")["windows"]) == 1
    print("PASS delayed descendant placement and owner/launch filtering", flush=True)

    probe = run / "headless"
    probe.mkdir()
    receipt = launch("--control", "--headless", "--owner", "validation", "--cwd", str(probe), "--", "foot", "--app-id=weld-headless-probe", sys.executable, str(Path(__file__).resolve()), "--input-probe")
    def controlled():
        return next((window for window in windows() if window["launch_id"] == receipt["launch_id"] and window["control"]), None)
    wait_for(host, controlled, "headless automatic control")
    window = controlled()
    assert not window["visible"] and not window["focused"] and window["workspace"] is None, window
    handle = window["control"]
    wait_for(host, lambda: (probe / "input.bin").exists(), "terminal program ready")
    invoke("input", control=handle, actions=[["t", "headless-input"], ["p", "Return"]])
    wait_for(host, lambda: b"headless-input\r" in (probe / "input.bin").read_bytes(), "headless keyboard delivery")
    invoke("resize", control=handle, width=960, height=540)
    wait_for(host, lambda: (controlled()["application_viewport"] or {}).get("logical_width") == 960, "headless resize")
    snapshot = invoke("capture", control=handle)
    png = base64.b64decode(snapshot["png_base64"], validate=True)
    assert png.startswith(b"\x89PNG\r\n\x1a\n")
    (run / "headless.png").write_bytes(png)
    invoke("peek", control=handle)
    wait_for(host, lambda: controlled()["visible"], "local peek")
    assert controlled()["application_viewport"]["logical_width"] == 960, controlled()
    invoke("peek", control=handle, visible=False)
    wait_for(host, lambda: controlled() and not controlled()["visible"], "peek dismissal")
    assert controlled()["control"] == handle
    invoke("input", control=handle, actions=[["t", "after-dismiss"]])
    wait_for(host, lambda: b"after-dismiss" in (probe / "input.bin").read_bytes(), "input after dismiss")
    invoke("peek", control=handle)
    wait_for(host, lambda: controlled()["visible"], "repeat peek")
    subprocess.run([*ctl, "access", "revoke", "--all"], check=True, capture_output=True, timeout=10)
    wait_for(host, lambda: not controlled(), "global revocation")
    assert "error" in window_rpc(control, "capture", {"control": handle})
    print("PASS headless input, resize, pixels, repeated peek/dismiss and global revoke", flush=True)


def check_windows(ctl, control, host, run, display, accessibility_app, text_app, xwayland):
    listing = json.loads(subprocess.check_output([*ctl, "window", "list", "--json"], text=True, timeout=10))
    window = next(window for window in listing["windows"] if window["app_id"] == "weld-launch-probe")
    details = json.loads(subprocess.check_output(
        [*ctl, "window", "get", window["id"], "--json"], text=True, timeout=10))
    assert details == window
    def rpc(method, params):
        return window_rpc(control, method, params)
    assert rpc("get", {"id": window["id"]})["result"] == details
    assert any(item["id"] == window["id"] for item in rpc("list", {})["result"]["windows"])
    assert rpc("missing_method", {})["error"]["code"] == -32601
    assert "error" in rpc("get", {"id": 123})
    schema = json.loads(subprocess.check_output(
        [*ctl, "window", "get", "--output-schema"], text=True, timeout=10))
    assert schema["properties"]["id"]["type"] == "string", schema
    assert "desktop_slot" in schema["properties"] and "application_viewport" in schema["properties"], schema
    with subprocess.Popen([*ctl, "mcp"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE) as mcp:
        def send(message):
            mcp.stdin.write(json.dumps(message).encode() + b"\n")
            mcp.stdin.flush()
        def request(identifier, method, params):
            send({"jsonrpc": "2.0", "id": identifier, "method": method, "params": params})
            return receive(identifier)
        def receive(identifier):
            if not select.select([mcp.stdout], [], [], 10)[0]:
                raise RuntimeError(f"MCP timed out on request {identifier}")
            reply = json.loads(mcp.stdout.readline())
            assert reply.get("id") == identifier, reply
            assert "error" not in reply, reply
            return reply["result"]
        try:
            initialized = request(1, "initialize", {
                "protocolVersion": "2025-11-25", "capabilities": {},
                "clientInfo": {"name": "weld-window-validation", "version": "1"},
            })
            assert "tools" in initialized["capabilities"]
            send({"jsonrpc": "2.0", "method": "notifications/initialized"})
            tools = request(2, "tools/list", {})["tools"]
            list_tool = next(tool for tool in tools if tool["name"] == "window_list")
            input_tool = next(tool for tool in tools if tool["name"] == "window_input")
            action_schema = input_tool["inputSchema"]["properties"]["actions"]["items"]
            assert len(action_schema["anyOf"]) == 5, action_schema
            assert all(row["type"] == "array" for row in action_schema["anyOf"]), action_schema
            assert "all_windows" in list_tool["inputSchema"]["properties"], list_tool
            assert {tool["name"] for tool in tools} == {
                "window_list", "window_get", "window_wait", "window_pointer", "window_click",
                "window_button", "window_key", "window_resize", "window_capture",
                "window_press_key", "window_chord", "window_scroll", "window_capture_after", "window_find",
                "window_resolve",
                "window_scale",
                "window_type_text",
                "window_input",
                "window_request_control",
                "window_accessibility",
                "window_peek",
            }
            result = request(3, "tools/call", {"name": "window_get", "arguments": {"id": window["id"]}})
            assert not result.get("isError"), result
            assert result["structuredContent"]["id"] == window["id"], result
            result = request(4, "tools/call", {"name": "window_get", "arguments": {"id": "absent"}})
            assert result.get("isError"), result
            empty = request(401, "tools/call", {"name": "window_list", "arguments": {}})
            assert empty["structuredContent"]["windows"] == [], empty
            complete = request(402, "tools/call", {"name": "window_list", "arguments": {"all_windows": True}})
            assert any(item["id"] == window["id"] for item in complete["structuredContent"]["windows"]), complete
            result = request(5, "tools/call", {"name": "window_wait", "arguments": {
                "after": 0, "timeout_ms": 1000}})
            assert result["structuredContent"]["revision"] >= listing["revision"], result
            revision = result["structuredContent"]["revision"]
            send({"jsonrpc": "2.0", "id": 6, "method": "tools/call", "params": {
                "name": "window_wait", "arguments": {"after": revision, "timeout_ms": 5000}}})
            subprocess.run([*ctl, "launch", "--", "foot", "--app-id=weld-window-wait-probe"],
                           check=True, capture_output=True, timeout=10)
            result = receive(6)
            assert result["structuredContent"]["revision"] > revision, result
            check_remote_control(rpc, request, window["id"], host, run, display)
            if accessibility_app:
                check_accessibility(ctl, rpc, request, host, run, accessibility_app)
            if text_app:
                for backend in (["wayland", "x11"] if xwayland else ["wayland"]):
                    check_text_entry(ctl, rpc, host, run, text_app, backend)
        finally:
            mcp.stdin.close()
            try:
                mcp.wait(timeout=5)
            except subprocess.TimeoutExpired:
                mcp.kill()
                mcp.wait(timeout=5)
                raise RuntimeError("MCP did not stop after stdin closed")
            assert mcp.returncode == 0, mcp.stderr.read().decode(errors="replace")
    print("PASS native window queries, full output schema, MCP initialize/list/call/errors/async wait", flush=True)


def check_remote_control(rpc, mcp, identifier, host, run, display):
    def invoke(method, **params):
        reply = rpc(method, params)
        assert "error" not in reply, reply
        return reply["result"]
    before = invoke("list")["windows"]
    focused = [window["id"] for window in before if window["focused"]]
    geometry = next(window["desktop_slot"] for window in before if window["id"] == identifier)
    invoke("control", id=identifier, enabled=True)
    wait_for(host, lambda: invoke("get", id=identifier)["control"] is not None, "control grant")
    handle = invoke("get", id=identifier)["control"]
    key = invoke("get", id=identifier)["control_key"]
    controlled = mcp(403, "tools/call", {"name": "window_list", "arguments": {}})
    assert [item["id"] for item in controlled["structuredContent"]["windows"]] == [identifier], controlled
    assert invoke("resolve", key=key)["control"] == handle
    assert len(handle) == 8 and key == "w" + identifier
    subprocess.run([str(Path(__file__).resolve().parent.parent / "target/debug/weldctl"),
                    "--session", str(display), "launch", "--", "wl-copy",
                    "--type", "text/plain;charset=utf-8", "--", key], check=True, capture_output=True, timeout=10)
    def copied():
        result = subprocess.run(["wl-paste", "--no-newline"],
                                env=dict(os.environ, WAYLAND_DISPLAY=str(display)),
                                capture_output=True, text=True, timeout=5)
        return result.returncode == 0 and result.stdout == key
    wait_for(host, copied, "clipboard control shorthand")
    wait_for(host, lambda: "result" in rpc("capture", {"control": handle}), "first controlled frame")
    receipt = invoke("resize", control=key, width=800, height=600)
    snapshot = invoke("capture_after", control=handle, sequence=receipt["sequence"], timeout_ms=5000)
    assert int(snapshot["revision"]) > int(receipt["frame_revision"])
    assert snapshot["after_sequence"] == receipt["sequence"]
    def resized():
        snapshot = invoke("capture", control=handle)
        return snapshot["logical_width"] == 800 and snapshot["logical_height"] == 600
    wait_for(host, resized, "independent remote viewport")
    assert invoke("get", id=identifier)["desktop_slot"] == geometry, "remote resize moved the peek frame"
    assert invoke("get", id=identifier)["application_viewport"]["logical_width"] == 800
    invoke("scale", control=key, factor=1.5)
    wait_for(host, lambda: invoke("capture", control=key)["pixel_scale"]["x"] == 1.5, "fractional app scale")
    assert invoke("get", id=identifier)["desktop_slot"] == geometry
    invoke("scale", control=key, factor=None)
    app_id = next(window["app_id"] for window in before if window["id"] == identifier)
    matches = invoke("find", app_id=app_id, occupied=True, controlled=True)["windows"]
    assert [window["id"] for window in matches] == [identifier]
    for keycode in [30, 28]:
        for pressed in [True, False]:
            result = mcp(20 + keycode * 2 + int(pressed), "tools/call", {
                "name": "window_key", "arguments": {"control": handle, "keycode": keycode, "pressed": pressed}})
            assert not result.get("isError"), result
    received = run / "input.bin"
    wait_for(host, lambda: received.exists() and b"a\r" in received.read_bytes(), "independent terminal keyboard input")
    invoke("press_key", control=handle, keycode=48)
    wait_for(host, lambda: b"b" in received.read_bytes(), "atomic key press")
    result = mcp(180, "tools/call", {"name": "window_chord", "arguments": {"control": key, "keycodes": [42, 46]}})
    assert not result.get("isError"), result
    wait_for(host, lambda: b"C" in received.read_bytes(), "atomic key chord")
    text = "Hei æøå — 世界 🦀 'quotes' \\" + "0123456789" * 60 + "\tend\n"
    result = mcp(181, "tools/call", {"name": "window_type_text", "arguments": {"control": key, "text": text}})
    assert not result.get("isError"), result
    assert result["structuredContent"]["stage"] == "effects_queued", result
    wait_for(host, lambda: text.replace("\n", "\r").encode() in received.read_bytes(), "whole Unicode text across keymap batches")
    invoke("press_key", control=handle, keycode=44)
    wait_for(host, lambda: received.read_bytes().endswith(b"z"), "normal keymap restored after text")
    assert copied(), "text input replaced the clipboard"
    before_invalid = received.read_bytes()
    assert "error" in rpc("type_text", {"control": key, "text": "valid prefix\u0000invalid"})
    invoke("key", control=handle, keycode=42, pressed=True)
    assert "error" in rpc("type_text", {"control": key, "text": "must not be typed"})
    invoke("key", control=handle, keycode=42, pressed=False)
    assert received.read_bytes() == before_invalid, "rejected text emitted partial input"
    for actions in [[["t", "must not type"], ["p", "NotAKey"]], [["t", "must not type"], ["p", ["Ctrl", "Control"]]]]:
        assert "error" in rpc("input", {"control": key, "actions": actions})
    assert received.read_bytes() == before_invalid, "invalid tail emitted earlier actions"
    actions = [["t", "seq"], ["p", "Return"], ["t", "abc"], ["p", "BackSpace"], ["p", ["Control", "a"]], ["p", "Return"]]
    result = mcp(182, "tools/call", {"name": "window_input", "arguments": {"control": key, "actions": actions}})
    assert not result.get("isError"), result
    progress = result["structuredContent"]
    assert progress["complete"] and progress["completed_actions"] == 6 and progress["typed_characters"] == 6, progress
    assert progress["receipt"]["stage"] == "effects_queued", progress
    wait_for(host, lambda: b"seq\rabc\x7f\x01\r" in received.read_bytes(), "named keys and remapped Control chord")
    started = time.monotonic()
    progress = invoke("input", control=key, actions=[["t", "paced"]], typing_interval_ms=40)
    assert progress["complete"] and time.monotonic() - started >= 0.15, progress
    wait_for(host, lambda: received.read_bytes().endswith(b"paced"), "paced text")
    invoke("click", control=handle, x=100, y=100, button=272)
    wait_for(host, lambda: b"\x1b[<0;" in received.read_bytes(), "terminal pointer input")
    invoke("scroll", control=handle, x=100, y=100, horizontal=0, vertical=1, wheel=True)
    wait_for(host, lambda: b"\x1b[<65;" in received.read_bytes(), "wheel input")
    after = invoke("list")["windows"]
    assert [window["id"] for window in after if window["focused"]] == focused, "remote input stole desktop focus"
    receipt = invoke("press_key", control=handle, keycode=32)
    result = mcp(200, "tools/call", {"name": "window_capture_after", "arguments": {
        "control": key, "sequence": receipt["sequence"], "timeout_ms": 5000}})
    assert not result.get("isError"), result
    image = next(content for content in result["content"] if content["type"] == "image")
    assert result["structuredContent"]["after_sequence"] == receipt["sequence"]
    png = base64.b64decode(image["data"], validate=True)
    assert png[:8] == b"\x89PNG\r\n\x1a\n", "MCP must return image pixels"
    assert int.from_bytes(png[16:20], "big") == result["structuredContent"]["width"]
    (run / "controlled-window.png").write_bytes(png)
    subprocess.run(["grim", str(run / "desktop-peek.png")], env=dict(os.environ, WAYLAND_DISPLAY=str(display)), check=True, timeout=10)
    invoke("resize", control=handle, width=1600, height=1400)
    wait_for(host, lambda: invoke("capture", control=handle)["logical_width"] == 1600, "oversized viewport")
    assert invoke("get", id=identifier)["desktop_slot"] == geometry
    subprocess.run(["grim", str(run / "desktop-clipped-peek.png")], env=dict(os.environ, WAYLAND_DISPLAY=str(display)), check=True, timeout=10)
    old_handle = handle
    invoke("permissions", id=identifier, view=False, keyboard=True, pointer=False, resize=False)
    wait_for(host, lambda: invoke("get", id=identifier)["control"] not in [None, old_handle], "permission change")
    window = invoke("get", id=identifier)
    handle = window["control"]
    assert window["capabilities"] == dict(view=False, keyboard=True, pointer=False, resize=False)
    assert invoke("resolve", key=key)["control"] == handle, "slot shorthand follows the new grant"
    assert "error" in rpc("capture", {"control": old_handle})
    assert "error" in rpc("type_text", {"control": old_handle, "text": "retired"})
    assert "error" in rpc("capture", {"control": handle})
    assert "error" in rpc("accessibility", {"control": handle})
    assert "error" in rpc("accessibility", {"control": old_handle})
    assert "error" in rpc("click", {"control": handle, "x": 100, "y": 100, "button": 272})
    assert "error" in rpc("resize", {"control": handle, "width": 400, "height": 300})
    subprocess.run(["grim", str(run / "desktop-restricted-control.png")], env=dict(os.environ, WAYLAND_DISPLAY=str(display)), check=True, timeout=10)
    invoke("key", control=handle, keycode=58, pressed=True)
    invoke("control", id=identifier, enabled=False)
    wait_for(host, lambda: invoke("get", id=identifier)["control"] is None, "control retirement")
    assert "error" in rpc("key", {"control": handle, "keycode": 30, "pressed": True})
    assert "error" in rpc("capture", {"control": handle})
    invoke("control", id=identifier, enabled=True)
    wait_for(host, lambda: invoke("get", id=identifier)["control"] is not None, "replacement grant")
    assert invoke("get", id=identifier)["control"] != handle, "old control ID reused"
    assert invoke("resolve", key=key)["control"] == invoke("get", id=identifier)["control"]
    offset = len(received.read_bytes())
    with concurrent.futures.ThreadPoolExecutor(max_workers=1) as executor:
        typing = executor.submit(rpc, "input", {"control": key, "actions": ["Z" * 20], "typing_interval_ms": 100})
        wait_for(host, lambda: len(received.read_bytes()) > offset, "paced input started")
        assert invoke("get", id=identifier)["control"], "queries blocked during typing"
        invoke("control", id=identifier, enabled=False)
        progress = typing.result(timeout=5)["result"]
        assert not progress["complete"] and progress["completed_actions"] == 0 and progress["error"], progress
        assert 0 < progress["typed_characters"] < 20, progress
        time.sleep(0.25)
        assert received.read_bytes()[offset:] == b"Z" * progress["typed_characters"], progress
    print("PASS independent input, viewport sizing, live peek, MCP image capture and grant retirement", flush=True)


def check_text_entry(ctl, rpc, host, run, program, backend):
    title = "Weld text probe " + backend
    output = run / ("text-" + backend + ".txt")
    launcher = "import subprocess,sys; result=subprocess.run(sys.argv[2:],capture_output=True,check=True); open(sys.argv[1],'wb').write(result.stdout)"
    subprocess.run([*ctl, "launch", *(["--shared-display"] if backend == "x11" else []), "--", "env", "GDK_BACKEND=" + backend,
                    sys.executable, "-c", launcher, str(output), program,
                    "--entry", "--title=" + title, "--text=Unicode input probe"], check=True, capture_output=True, timeout=10)
    def window():
        return next((item for item in rpc("list", {})["result"]["windows"] if item["title"] == title), None)
    wait_for(host, lambda: window() is not None, "text entry " + backend)
    identifier = window()["id"]
    assert "result" in rpc("control", {"id": identifier, "enabled": True})
    wait_for(host, lambda: window()["control"] is not None, "text entry grant")
    control = window()["control"]
    wait_for(host, lambda: "result" in rpc("capture", {"control": control}), "text entry ready")
    text = "Hello Æøå 世界 🦀 " + "abc123" * 100
    result = subprocess.run([*ctl, "window", "type-text", "--control=" + control, "--text=" + text, "--json"], capture_output=True, text=True, timeout=10)
    if backend == "x11":
        assert result.returncode != 0 and "native Wayland" in json.loads(result.stdout)["error"], result
        # Confirm refusal leaves the field empty and normal key input usable.
        assert "result" in rpc("input", {"control": control, "actions": [["p", "a"]]})
        text = "a"
    else:
        assert result.returncode == 0, result.stderr
    assert "result" in rpc("press_key", {"control": control, "keycode": 28})
    wait_for(host, output.exists, "submitted text entry " + backend)
    actual = output.read_text().rstrip("\n")
    assert actual == text, (backend, actual, text)
    print("PASS " + ("X11 text refusal without partial input" if backend == "x11" else "Unicode GTK text entry and keymap restoration"), flush=True)


def check_accessibility(ctl, rpc, mcp, host, run, program):
    title = "Weld accessibility probe"
    subprocess.run([*ctl, "launch", "--", "env", "GTK_A11Y=atspi", "GDK_BACKEND=wayland", "LC_ALL=C",
                    program, "--entry", "--title=" + title, "--text=Accessible test entry",
                    "--entry-text=Probe value"], check=True, capture_output=True, timeout=10)
    def window():
        return next((item for item in rpc("list", {})["result"]["windows"] if item["title"] == title), None)
    wait_for(host, lambda: window() is not None, "GTK probe window")
    identifier = window()["id"]
    assert "result" in rpc("control", {"id": identifier, "enabled": True})
    wait_for(host, lambda: window()["control"] is not None, "GTK control grant")
    key = window()["control_key"]
    def inspect():
        reply = rpc("accessibility", {"control": key, "max_nodes": 256})
        assert "error" not in reply, reply
        return reply["result"]
    wait_for(host, lambda: inspect()["status"] == "ready", "GTK AT-SPI registration")
    tree = inspect()
    (run / "accessibility.json").write_text(json.dumps(tree, indent=2))
    assert not tree["truncated"], tree
    assert any(node["name"] == title for node in tree["nodes"]), tree
    assert any(node["role"] == "button" and node["bounds"] for node in tree["nodes"]), tree
    assert any(node["role"] in ["text", "entry"] for node in tree["nodes"]), tree
    tiny = rpc("accessibility", {"control": key, "max_nodes": 1})["result"]
    assert len(tiny["nodes"]) == 1 and tiny["truncated"], tiny
    filtered = rpc("accessibility", {"control": key, "role": "BUTTON", "query": "ok"})["result"]
    assert filtered["nodes"] and all(node["role"] == "button" and "ok" in node["name"].lower() for node in filtered["nodes"]), filtered
    assert filtered["visited_nodes"] > len(filtered["nodes"]), filtered
    shallow = rpc("accessibility", {"control": key, "max_depth": 0})["result"]
    assert len(shallow["nodes"]) == 1 and shallow["truncated"], shallow
    assert "error" in rpc("accessibility", {"control": key, "max_nodes": 0})
    result = mcp(500, "tools/call", {"name": "window_accessibility", "arguments": {
        "control": key, "max_nodes": 8, "role": "button", "query": "ok"}})
    assert not result.get("isError"), result
    assert result["structuredContent"]["status"] == "ready", result
    assert len(result["structuredContent"]["nodes"]) == 1, result
    cli = json.loads(subprocess.check_output([*ctl, "window", "accessibility", "--control", key,
                                             "--max-nodes", "8", "--role", "button", "--query", "ok",
                                             "--json"], text=True, timeout=10))
    assert cli["status"] == "ready", cli
    assert len(cli["nodes"]) == 1 and cli["nodes"][0]["name"] == "OK", cli
    handle = window()["control"]
    assert "result" in rpc("permissions", {"id": identifier, "view": False, "keyboard": True,
                                           "pointer": False, "resize": False})
    wait_for(host, lambda: window()["control"] != handle, "GTK view revocation")
    assert "error" in rpc("accessibility", {"control": key})
    assert "error" in rpc("accessibility", {"control": handle})
    print("PASS GTK accessibility tree through CLI/RPC/MCP, node limits and view revocation", flush=True)


def child():
    root = Path(__file__).resolve().parent.parent
    facts = {
        "pid": os.getpid(), "cwd": os.getcwd(), "argv": sys.argv[3:],
        "environment": {key: os.environ[key] for key in (
            "WAYLAND_DISPLAY", "WAYLAND_SOCKET", "DISPLAY", "SWAYSOCK", "I3SOCK", "WELD_SESSION",
        ) if key in os.environ},
    }
    # Rename makes readiness publication atomic for the supervising test.
    Path("child.pending.json").write_text(json.dumps(facts))
    Path("child.pending.json").rename("child.json")
    if sys.argv[2] == "nested":
        os.execvp("foot", ["foot", "--app-id=weld-launch-probe", "--title=Weld launch probe",
                           sys.executable, str(Path(__file__).resolve()), "--input-probe"])
    probe = str(root / "target/debug/examples/wayland_session_probe")
    os.execv(probe, [probe, "--dormant", "--expected-output", "640x480",
                    "--expected-scale", "2", "--expected-size", "1100x300"])


if __name__ == "__main__":
    if sys.argv[1:] == ["--input-probe"]:
        tty.setraw(sys.stdin.fileno())
        sys.stdout.write("\x1b[?1000h\x1b[?1006h\x1b[36mWeld remote input probe\x1b[0m\r\n")
        sys.stdout.flush()
        with Path("input.bin").open("ab", buffering=0) as received:
            while data := os.read(sys.stdin.fileno(), 1024):
                received.write(data)
                sys.stdout.write(repr(data) + "\r\n")
                sys.stdout.flush()
    elif len(sys.argv) > 2 and sys.argv[1] == "--child":
        child()
    else:
        main()

#!/usr/bin/env python3
"""Exercise Grim and clipboard capture in an isolated nested Weld session."""

import concurrent.futures
import json
import os
from pathlib import Path
import signal
import struct
import subprocess
import sys
import tempfile
import time


def png_size(data):
    if not data.startswith(b"\x89PNG\r\n\x1a\n") or data[12:16] != b"IHDR":
        raise RuntimeError(f"capture is not PNG: {data[:120]!r}")
    return struct.unpack(">II", data[16:24])


def main():
    root = Path(__file__).resolve().parent.parent
    subprocess.run(["cargo", "build", "-p", "weldwm", "--locked", "-j8"], cwd=root, check=True)
    validation = root / "target/validation"
    validation.mkdir(exist_ok=True)
    run = Path(tempfile.mkdtemp(prefix="screenshot-", dir=validation))
    config = run / "capture.config"
    config.write_text("font monospace 14\ndefault_border pixel 2\n")
    socket = run / "wayland"
    environment = dict(os.environ, RUST_LOG=os.environ.get("RUST_LOG", "warn"))
    client_environment = dict(environment, WAYLAND_DISPLAY=str(socket))
    client_environment.pop("WAYLAND_SOCKET", None)
    children = []
    with (run / "host.log").open("w") as log:
        host = subprocess.Popen([
            "cargo", "run", "-p", "weldwm", "--locked", "--", "--backend", "nested",
            "--config", str(config), "--wayland-socket", str(socket), "--",
            sys.executable, str(Path(__file__).resolve()), "--client", str(run / "client.json"),
        ], cwd=root, env=environment, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
        try:
            deadline = time.monotonic() + 40
            while not socket.exists() or not (run / "client.json").exists():
                if host.poll() is not None or time.monotonic() >= deadline:
                    raise RuntimeError(f"Weld did not start: {run / 'host.log'}")
                time.sleep(0.05)
            time.sleep(2)
            client_environment.update(json.loads((run / "client.json").read_text()))

            def capture(*options):
                return subprocess.check_output(["grim", *options, "-"], env=client_environment, timeout=15)

            full = capture()
            dimensions = png_size(full)
            (run / "full.png").write_bytes(full)
            assert min(dimensions) > 100, dimensions
            region = capture("-s", "1", "-g", "12,16 128x96")
            assert png_size(region) == (128, 96)
            (run / "region.png").write_bytes(region)
            print(f"PASS full output {dimensions} and exact region geometry", flush=True)
            with_cursor = capture("-c")
            assert png_size(with_cursor) == dimensions
            (run / "cursor.png").write_bytes(with_cursor)

            # Exercise independent session lifetimes and bounded readback completion.
            with concurrent.futures.ThreadPoolExecutor(max_workers=3) as workers:
                results = list(workers.map(lambda _: png_size(capture()), range(6)))
            assert all(size == dimensions for size in results), results
            print("PASS concurrent Grim sessions", flush=True)

            # A disconnected capture must release its slot and leave future requests usable.
            cancelled = subprocess.Popen(["grim", "-"], env=client_environment,
                                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                         start_new_session=True)
            children.append(cancelled)
            time.sleep(0.005)
            cancelled.terminate()
            cancelled.wait(timeout=5)
            assert png_size(capture()) == dimensions
            print("PASS capture after client cancellation", flush=True)

            subprocess.run(["grimshot", "save", "screen", str(run / "grimshot.png")],
                           env=client_environment, check=True, timeout=15)
            assert png_size((run / "grimshot.png").read_bytes()) == dimensions
            tree = json.loads(subprocess.check_output(["swaymsg", "-t", "get_tree", "-r"], env=client_environment, timeout=5))
            outputs = json.loads(subprocess.check_output(["swaymsg", "-t", "get_outputs", "-r"], env=client_environment, timeout=5))
            assert any(output["name"] == "weld-nested" and output["focused"] for output in outputs), outputs
            def leaves(node):
                if "pid" in node:
                    yield node
                for child in node["nodes"] + node["floating_nodes"]:
                    yield from leaves(child)
            windows = list(leaves(tree))
            assert any(window["pid"] > 0 and window["focused"] and window["visible"] for window in windows), windows
            for selector in ("active", "output"):
                destination = run / f"grimshot-{selector}.png"
                subprocess.run(["grimshot", "save", selector, str(destination)], env=client_environment, check=True, timeout=15)
                assert min(png_size(destination.read_bytes())) > 0
            print("PASS live tree/output IPC and Grimshot active/output selectors", flush=True)
            clipboard_environment = dict(client_environment, WAYLAND_DEBUG="client")
            with (run / "clipboard.log").open("w") as clipboard_log:
                clipboard = subprocess.Popen(["wl-copy", "--foreground", "--type", "image/png"],
                                             env=clipboard_environment, stdin=subprocess.PIPE,
                                             stderr=clipboard_log, start_new_session=True)
                children.append(clipboard)
                clipboard.stdin.write(full)
                clipboard.stdin.close()
                time.sleep(0.2)
                copied = subprocess.check_output(["wl-paste", "--type", "image/png", "--no-newline"],
                                                 env=clipboard_environment, stderr=clipboard_log, timeout=5)
            assert copied == full
            assert ".get_toplevel(" not in (run / "clipboard.log").read_text(), "clipboard tools opened a temporary window"
            print("PASS Grimshot save and PNG clipboard round-trip", flush=True)
        finally:
            for process in [*children, host]:
                if process.poll() is None:
                    os.killpg(process.pid, signal.SIGTERM)
                    try:
                        process.wait(timeout=5)
                    except subprocess.TimeoutExpired:
                        os.killpg(process.pid, signal.SIGKILL)
                        process.wait(timeout=5)
            print(f"Logs and captures: {run}", flush=True)


if __name__ == "__main__":
    if len(sys.argv) == 3 and sys.argv[1] == "--client":
        Path(sys.argv[2]).write_text(json.dumps({key: os.environ[key] for key in ("SWAYSOCK", "WAYLAND_DISPLAY")}))
        os.execvp("foot", ["foot", "--title=Weld capture test", "sh", "-c",
                           "printf '\033[44m\033[2J\033[HGrim capture test\n'; sleep 120"])
    else:
        main()

#!/usr/bin/env bash
set -euo pipefail
if [[ $# -gt 1 || ( $# == 1 && $1 != --clippy && $1 != --help ) ]]; then
  echo 'Usage: build-android-codec-probe [--clippy|--help]' >&2; exit 2
fi
if [[ ${1:-} == --help ]]; then
  echo 'Build the debug ARM64/API28 native-buffer probe, dex bootstrap and tiny fixtures.'
  echo 'No device is installed or launched. --clippy checks Android code instead of linking.'
  exit 0
fi
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
"$root/scripts/build-android-ffmpeg"
prefix=$("$root/scripts/build-android-ffmpeg" --print-prefix)
[[ -f $prefix/complete ]] || { echo 'Verified Android FFmpeg prefix missing.' >&2; exit 1; }
ndk=${ANDROID_NDK_HOME:-${ANDROID_NDK_ROOT:-}}
toolchain="$ndk/toolchains/llvm/prebuilt/linux-x86_64"
sdk=${ANDROID_HOME:-${ANDROID_SDK_ROOT:-}}
[[ -x $sdk/build-tools/36.1.0/d8 ]] || { echo 'Android build-tools 36.1.0 missing.' >&2; exit 1; }
[[ -f $sdk/platforms/android-36/android.jar ]] || { echo 'Android platform 36 missing.' >&2; exit 1; }
export FFMPEG_DIR="$prefix"
export PKG_CONFIG_LIBDIR= PKG_CONFIG_PATH=
export BINDGEN_EXTRA_CLANG_ARGS_aarch64_linux_android="--sysroot=$toolchain/sysroot --target=aarch64-linux-android28"
output="$root/target/android-codec-probe"
mkdir -p "$output/classes" "$output/dex" "$output/fixtures"
export CARGO_TARGET_DIR="$output/cargo"
if [[ ${1:-} == --clippy ]]; then
  cargo ndk -t arm64-v8a --platform 28 clippy --locked \
    --manifest-path "$root/tools/ffmpeg-android-probe/Cargo.toml" --all-targets -j2 -- -D warnings
  exit 0
fi
cargo ndk -t arm64-v8a --platform 28 build --locked \
  --manifest-path "$root/tools/ffmpeg-android-probe/Cargo.toml" -j2
javac --release 8 -classpath "$sdk/platforms/android-36/android.jar" \
  -d "$output/classes" "$root/tools/ffmpeg-android-probe/WeldCodecProbe.java"
"$sdk/build-tools/36.1.0/d8" --min-api 28 --output "$output/dex" "$output/classes/WeldCodecProbe.class"
# Each fixture is 12 low-delay AUs, not a benchmark. Software fixture encoding
# avoids exercising the host GPU or the known high-bitrate Radeon failure.
ffmpeg -version > "$output/fixtures/encoder-version.txt"
for codec in av1 h264 vp9; do
  case "$codec" in
    av1) encoder=(libaom-av1 -cpu-used 8 -lag-in-frames 0); container=ivf ;;
    h264) encoder=(libx264 -preset ultrafast -tune zerolatency); container=h264 ;;
    vp9) encoder=(libvpx-vp9 -deadline realtime -cpu-used 8 -lag-in-frames 0); container=ivf ;;
  esac
  timeout 30s ffmpeg -hide_banner -v error -f lavfi -i testsrc2=size=320x180:rate=60 \
    -frames:v 12 -an -c:v "${encoder[@]}" -threads 2 -g 12 -b:v 500k \
    -f "$container" -y "$output/fixtures/$codec.$container"
done
library="$output/cargo/aarch64-linux-android/debug/libffmpeg_android_probe.so"
"$toolchain/bin/llvm-readelf" -h -d "$library" > "$output/probe.elf.txt"
grep -q 'Machine:.*AArch64' "$output/probe.elf.txt"
while read -r dependency; do
  case "$dependency" in
    libavutil.so|libavcodec.so|libavformat.so|libc.so|libm.so|libdl.so|liblog.so|libandroid.so|libmediandk.so) ;;
    *) echo "Unexpected Android probe dependency: $dependency" >&2; exit 1 ;;
  esac
done < <(sed -n 's/.*(NEEDED).*\[\(.*\)\].*/\1/p' "$output/probe.elf.txt")
printf '%s\n' "$prefix" > "$output/ffmpeg-prefix.txt"
echo "Probe ready: $output (not deployed; no Godot presentation yet)."

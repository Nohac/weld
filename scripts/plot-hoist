#!/usr/bin/env python3
"""Plot Weld-to-Weld or Godot hoist logs as an interactive HTML/uPlot report.

No Python packages or browser service required. Charts load pinned uPlot assets
from a CDN; measurements stay embedded in the report. Pass a run directory to
select an older run, or a weld-hoist-source-*.log file for local hoist.
Missing measurements are never invented. No argument selects the latest run.
"""
import argparse
from datetime import datetime, timezone
import html
import json
import math
from pathlib import Path
import re
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
UPLOT_CDN = "https://cdn.jsdelivr.net/npm/uplot@1.6.32/dist"
FIELDS = re.compile(r"\b([A-Za-z_][A-Za-z_0-9]*)=([-+]?\d+(?:\.\d+)?)")


def timestamp(line, year):
    line = line.lstrip()
    match = re.search(r"\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(?:\.\d+)?Z", line)
    if match:
        return datetime.fromisoformat(match[0]).timestamp()
    match = re.match(r"(\d{10}\.\d+)\s", line)
    if match:
        return float(match[1])
    match = re.match(r"(\d\d-\d\d \d\d:\d\d:\d\d\.\d+)", line)
    if match:
        # Old logcat threadtime uses device local time. The report warns that
        # cross-device clock alignment is approximate, never one-way latency.
        return datetime.strptime(f"{year}-{match[1]}", "%Y-%m-%d %H:%M:%S.%f").timestamp()
    return None


def joined_lines(source):
    pending = {}
    for line in source:
        match = re.search(r"WELD_TRACE id=(\d+) part=(\d+) total=(\d+) (.*)", line.rstrip("\n"))
        if not match:
            yield line
            continue
        identifier, part, total, payload = match.groups()
        part, total = int(part), int(total)
        if not 1 <= part <= total <= 8 or len(pending) >= 256:
            yield "WELD_DIAGNOSTICS_GAP invalid_or_excessive_fragments\n"
            pending.clear()
            continue
        pieces = pending.setdefault(identifier, {})
        pieces[part] = payload
        if len(pieces) == total and all(index in pieces for index in range(1, total + 1)):
            yield ''.join(pieces[index] for index in range(1, total + 1)) + '\n'
            del pending[identifier]
    if pending:
        yield f"WELD_DIAGNOSTICS_GAP incomplete_records={len(pending)}\n"


def log_paths(run):
    if run.is_file():
        if not (run.name.startswith("weld-hoist-source-") and run.suffix == ".log"):
            raise ValueError("expected a run directory or weld-hoist-source-*.log file")
        return [run, run.with_name(run.name.replace("-source-", "-destination-", 1))]
    receivers = [run / name for name in ("viewer.log", "destination.log") if (run / name).is_file()]
    if len(receivers) > 1:
        raise ValueError("both viewer.log and destination.log exist; select a directory with one receiver")
    receiver = receivers[0] if receivers else run / ("viewer.log" if run.name.startswith("godot-hoist-") else "destination.log")
    paths = [run / "source.log", receiver]
    paths += sorted(run.glob("restart*/source.log"))
    paths += sorted(run.glob("restart*/" + receiver.name))
    return paths


def latest_run(validation):
    candidates = []
    for pattern in ("godot-hoist-*", "iroh-*", "headless-iroh-*", "network-hoist-*"):
        for run in validation.glob(pattern):
            if run.is_dir() and (run / "source.log").is_file():
                candidates.append(run)
    candidates += list(validation.glob("weld-hoist-source-*.log"))
    if not candidates:
        raise ValueError("no hoist runs found")
    return max(candidates, key=lambda run: max(path.stat().st_mtime for path in log_paths(run) if path.is_file()))


def read_records(run):
    records = []
    notices = []
    metadata = {}
    metadata_path = run / "run.json"
    if run.is_dir() and metadata_path.exists():
        try:
            if metadata_path.stat().st_size > 1024 * 1024:
                raise ValueError("exceeds 1 MiB input bound")
            metadata = json.loads(metadata_path.read_text())
            if not isinstance(metadata, dict):
                raise ValueError("expected an object")
        except (OSError, ValueError) as error:
            notices.append(f"Run metadata unavailable: {error}")
            metadata = {}
    paths = log_paths(run)
    fallback_time = next((path.stat().st_mtime for path in paths if path.is_file()), run.stat().st_mtime)
    try:
        year = datetime.fromtimestamp(metadata.get("started_at", fallback_time)).year
    except (TypeError, ValueError, OverflowError, OSError):
        notices.append("Invalid run start time; legacy timestamps use the log file year.")
        year = datetime.fromtimestamp(fallback_time).year
    markers = {
        "presentation observations": "presentation",
        "encoded destination observations": "decode",
        "encoded source observations": "source",
        "encoded transport observations": "transport",
        "encoded selected-path observations": "network",
        "opened VA-API encoder generation": "encoder",
        "Iroh selected path snapshot": "path",
        "Iroh ADB link observations": "adb",
    }
    for path in paths:
        if not path.exists():
            notices.append(f"Missing {path.name} (run may still be active).")
            continue
        if path.stat().st_size > 64 * 1024 * 1024:
            raise ValueError(f"{path} exceeds the 64 MiB input bound")
        with path.open(errors="replace") as source:
            for line in joined_lines(source):
                if "WELD_CAPTURE_GAP" in line or "WELD_DIAGNOSTICS_GAP" in line or "[truncated]" in line:
                    notices.append("Log capture has missing/truncated data: " + line.strip()[:180])
                kind = next((kind for marker, kind in markers.items() if marker in line), None)
                fields = {key: float(value) for key, value in FIELDS.findall(line)}
                if "PxrMetric:" in line and "Pkg=com.example.weldvr," in line:
                    kind = "xr"
                if "WELD_HOIST_STATUS" in line:
                    match = re.search(r"(\d+) layers, decoded (\d+), presented (\d+), superseded (\d+)", line)
                    if match:
                        kind = "legacy"
                        fields = dict(zip(["layers", "decoded", "imported", "unknown_discard"], map(float, match.groups())))
                when = timestamp(line, year)
                if kind and when is not None:
                    record = dict(time=when, kind=kind, fields=fields, file=str(path))
                    if kind == "encoder":
                        codec = re.search(r"\bcodec=(Av1|H264|Vp9)\b", line)
                        if codec:
                            record["codec"] = codec[1].lower()
                    if kind == "path":
                        transport = re.search(r'\btransport="?([a-z0-9_-]+)', line)
                        if transport:
                            record["transport"] = transport[1]
                    records.append(record)
                if len(records) > 20000:
                    raise ValueError("too many samples; select a shorter run")
    if not metadata and any(row["kind"] == "legacy" for row in records):
        notices.append("Legacy capture: receiver data may contain only the final logcat tail; startup is incomplete.")
    return sorted(records, key=lambda row: row["time"]), list(dict.fromkeys(notices)), metadata


def cumulative(rows, fields, epoch=None):
    """Connection/path resets and disappearing legacy windows are boundaries."""
    result = []
    previous = None
    for row in rows:
        current = row["fields"]
        if any(field not in current for field in fields):
            previous = None
            continue
        if previous is not None:
            old = previous["fields"]
            duration = row["time"] - previous["time"]
            reset = row["file"] != previous["file"] or (epoch is not None and current.get(epoch) != old.get(epoch))
            reset |= any(current[field] < old[field] for field in fields)
            if duration > 0 and not reset:
                result.append((previous["time"], row["time"], [(current[field] - old[field]) / duration for field in fields]))
        previous = row
    return result


def sampled(rows, fields, divisor=1):
    return [(row["time"] - 0.8, row["time"], [row["fields"].get(field, 0) / divisor for field in fields])
            for row in rows if all(field in row["fields"] for field in fields)]


def interval(rows, fields):
    result = []
    for row in rows:
        duration = row["fields"].get("interval_us", 0) / 1e6
        if duration > 0 and all(field in row["fields"] for field in fields):
            result.append((row["time"] - duration, row["time"], [row["fields"][field] / duration for field in fields]))
    return result


def chart_data(points, start, series_count):
    """Keep interval coverage and explicit gaps on uPlot's shared numeric axis."""
    samples = {}
    points = sorted(points, key=lambda point: point[0])
    for index, (beginning, finish, values) in enumerate(points):
        # A newer measurement supersedes overlapping display coverage.
        if index + 1 < len(points):
            finish = min(finish, points[index + 1][0])
        beginning, finish = max(beginning - start, 0), max(finish - start, 0)
        if finish <= beginning:
            continue
        samples[beginning] = values
        # Preserve the measured span to its right edge, then break the path.
        # An adjacent interval replaces this null with its own value.
        samples[math.nextafter(finish, -math.inf)] = values
        samples[finish] = [None] * series_count
    times = sorted(samples)
    return [times, *[[samples[time][index] for time in times] for index in range(series_count)]]


def chart(title, labels, points, start, end, unit, average_kind="interval"):
    heading = f"<h2>{html.escape(title)}</h2>"
    if not points:
        return f"<section>{heading}<p class='missing'>Unavailable — not recorded in these logs.</p></section>"
    descriptions = {
        "interval": "Duration-weighted averages over measured intervals; gaps excluded.",
        "sample": "Averages of recorded samples; missing samples excluded.",
        "maxima": "Averages of recorded maxima, not average frame latency.",
    }
    payload = json.dumps(dict(labels=labels, data=chart_data(points, start, len(labels)),
                              measurements=[(a - start, b - start, values) for a, b, values in points],
                              average_kind=average_kind,
                              end=max(end - start, 1), unit=unit), allow_nan=False,
                         separators=(",", ":")).replace("<", "\\u003c")
    return (f"<section>{heading}<p>{html.escape(unit)} · {descriptions[average_kind]}</p><div class='chart' "
            f"role='img' aria-label='{html.escape(title, quote=True)}'></div>"
            f"<script type='application/json' class='chart-data'>{payload}</script></section>")


def report(run):
    records, notices, metadata = read_records(run)
    if not records:
        raise ValueError("no timestamped diagnostic samples found; record a run with "
                         "RUST_LOG=info,weld_media_diag=debug,weld_network_diag=debug")
    groups = {kind: [row for row in records if row["kind"] == kind] for kind in {row["kind"] for row in records}}
    start, end = records[0]["time"], records[-1]["time"]
    get = lambda kind: groups.get(kind, [])
    for kind, description in (("source", "Weld backend/source timing"),
                              ("transport", "Weld backend media-send queues"),
                              ("network", "Network RTT and packet-loss measurements")):
        if not get(kind):
            notices.append(f"{description} unavailable: not recorded. Missing data does not mean zero activity or zero loss.")
    codec_names = {"av1": "AV1", "h264": "H.264", "vp9": "VP9"}
    observed_codecs = sorted({row["codec"] for row in get("encoder") if "codec" in row})
    if observed_codecs:
        codec_label = ", ".join(codec_names[codec] for codec in observed_codecs) + " (encoder logs)"
    else:
        requested_codec = codec_names.get(str(metadata.get("codec", "")))
        codec_label = f"{requested_codec} (requested; not confirmed in logs)" if requested_codec else "Unknown — not recorded"
    charts = []
    path_names = {"adb": "ADB byte stream", "ipv4": "Direct IPv4", "ipv6": "Direct IPv6", "relay": "Iroh relay"}
    observed_paths = sorted({row["transport"] for row in get("path") if "transport" in row})
    requested = metadata.get("transport", "not recorded")
    if requested == "adb-loopback":
        transport_label = "Custom TCP loopback (no USB)"
    elif observed_paths:
        transport_label = ", ".join(path_names.get(path, path) for path in observed_paths) + " (observed)"
    else:
        transport_label = "Not observed"
    transport_label += f"; requested: {requested}"
    def add(title, labels, data, units, average_kind="interval"):
        charts.append(chart(title, labels, data, start, end, units, average_kind))
    if get("presentation"):
        labels = ["Imported to GPU texture", "Superseded (queue replacement)", "Stale snapshot", "Layout change", "Lifecycle", "Handoff replacement"]
        fields = ["imported_total", "superseded_total", "stale_total", "layout_discard_total", "lifecycle_discard_total", "handoff_discard_total"]
        if all("decoded_total" in row["fields"] for row in get("presentation")):
            labels.append("Decoded (not an additional outcome)")
            fields.append("decoded_total")
        add("Receiver frame outcomes", labels, cumulative(get("presentation"), fields), "frames/s")
    elif get("legacy"):
        notices.append("Legacy superseded counts do not distinguish staleness, layout changes or queue replacement. Window-count changes reset the baseline.")
        add("Legacy receiver outcomes — discard reasons unavailable", ["Imported", "Superseded (unknown reason)"],
            cumulative(get("legacy"), ["imported", "unknown_discard"], "layers"), "frames/s")
    else:
        notices.append("Receiver presentation outcomes unavailable. Decode completion is not display presentation; "
                       "superseded and displayed-frame counts cannot be inferred from these logs.")
        add("Receiver decode throughput — not presentation", ["Completed decodes"],
            interval(get("decode"), ["decodes_completed"]), "frames/s")
    add("Network RTT", ["Round-trip time"], sampled(get("network"), ["rtt_us"], 1000), "ms", "sample")
    if any("route" not in row["fields"] for row in get("adb")):
        notices.append("ADB samples without a route ID omitted from per-link drop charts.")
    for file, route in sorted({(row["file"], row["fields"]["route"]) for row in get("adb") if "route" in row["fields"]}, key=str):
        rows = [row for row in get("adb") if row["file"] == file and row["fields"].get("route") == route]
        add(f"ADB adapter queue drops — {Path(file).name}, link {route:g}", ["Packets dropped before socket write; not USB loss"],
            cumulative(rows, ["adapter_dropped_total"]), "packets/s")
    if get("presentation"):
        add("Presentation delay — interval maxima", ["Snapshot wait", "Render-thread handoff", "Import CPU wall time"],
            sampled(get("presentation"), ["snapshot_wait_max_us", "render_handoff_max_us", "import_cpu_max_us"], 1000), "ms", "maxima")
        add("Presentation blocked checks — not dropped frames", ["Render callback busy", "GPU fence busy"],
            cumulative(get("presentation"), ["render_busy_checks_total", "fence_busy_checks_total"]), "checks/s")
        add("Commit arrival gaps — includes legitimate idle periods", ["Largest gap"],
            sampled(get("presentation"), ["commit_gap_max_us"], 1000), "ms", "maxima")
        add("Bursty presentation commits — after decoding, not source production", ["Commits less than half a refresh interval apart"],
            cumulative(get("presentation"), ["commit_bursts_total"]), "events/s")
    add("Weld backend/source operations — commits and batches are different units", ["Application commits received", "Commits coalesced", "Encoded batches"],
        interval(get("source"), ["commits_received", "commits_coalesced", "batches_completed"]), "operations/s")
    add("Weld backend encode timing", ["Completed batch wall time (interval maximum)", "Current batch age"],
        sampled(get("source"), ["batch_wall_max_us", "active_batch_age_us"], 1000), "ms", "maxima")
    add("Weld backend queues", ["Pending events", "Retained output records"],
        sampled(get("source"), ["pending_events", "retained_output_records"]), "records", "sample")
    add("Weld backend encoded output", ["Encoded layer frames"],
        interval(get("source"), ["layer_frames_completed"]), "frames/s")
    add("Weld backend encoded payload — excludes transport overhead", ["Encoded payload"],
        [(a, b, [value * 8 / 1e6 for value in values])
         for a, b, values in interval(get("source"), ["encoded_payload_bytes"])], "Mbps")
    add("Receiver ingress and decode throughput — different units", ["Received commits", "Received media frames", "Completed decodes"],
        interval(get("decode"), ["commits_received", "media_received", "decodes_completed"]), "operations/s")
    add("Receiver queues", ["Pending events", "Pending media frames", "Decode jobs in flight"],
        sampled(get("decode"), ["pending_events", "pending_media_frames", "decode_jobs_in_flight"]), "items", "sample")
    add("Receiver decode stages — overlapping interval maxima", ["Ingress → submit", "Worker queue", "Worker residence", "Completion handoff"],
        sampled(get("decode"), ["media_wait_max_us", "worker_queue_max_us", "worker_residence_max_us", "completion_handoff_max_us"], 1000), "ms", "maxima")
    add("Receiver cancellation/failure — not congestion or packet-loss counts", ["Decode cancelled", "Commit cancelled", "Media after cancellation", "Codec failure"],
        interval(get("decode"), ["decodes_cancelled", "commits_cancelled", "late_cancelled_media", "codec_failures"]), "events/s")
    add("QUIC packets declared lost — may be retransmitted", ["Packets declared lost"],
        cumulative(get("network"), ["lost_packets_total"], "path_epoch"), "packets/s")
    add("Media send backlog and write delay", ["Oldest pending", "Maximum write wall time (lifetime)"],
        sampled(get("transport"), ["oldest_pending_age_us", "write_wall_max_us"], 1000), "ms", "sample")
    add("Media records cancelled before full write — includes teardown", ["Cancelled records"],
        cumulative(get("transport"), ["cancelled_records_total"]), "records/s")
    if get("xr"):
        add("XR rendering time", ["CPU", "GPU"], sampled(get("xr"), ["FrmCpu", "FrmGpu"]), "ms", "sample")
        add("XR runtime-reported late frames", ["Late count"], sampled(get("xr"), ["FrmLate"]), "count/sample", "sample")
        add("XR frame rate", ["App FPS"], sampled(get("xr"), ["FPS"]), "fps", "sample")
    notices.append("Cross-device wall-clock alignment is approximate. No one-way network latency is inferred; overlapping stage durations must not be added.")
    notices.append("Low application activity can legitimately produce fewer video frames than the display refresh rate. Gaps do not establish packet loss.")
    if get("presentation") or get("legacy"):
        notices.append("Texture imports are not display scanouts.")
    warnings = ''.join(f"<li>{html.escape(note)}</li>" for note in notices)
    encoders = []
    for row in get("encoder"):
        fields = row["fields"]
        required = ["stream", "generation", "frame_rate_millihertz", "visible_width", "visible_height", "bitrate_bits"]
        if all(key in fields for key in required):
            encoders.append(f"<tr><td>{row['time']-start:.2f}s</td><td>{fields['stream']:.0f}/{fields['generation']:.0f}</td>"
                            f"<td>{fields['visible_width']:.0f}×{fields['visible_height']:.0f}</td>"
                            f"<td>{fields['frame_rate_millihertz']/1000:.1f} fps</td><td>{fields['bitrate_bits']/1e6:.2f} Mbps</td></tr>")
    javascript = Path(__file__).with_name("godot-hoist-charts.js").read_text()
    return f"""<!doctype html><html lang='en'><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><title>Weld run diagnostics</title>
<link rel='stylesheet' href='{UPLOT_CDN}/uPlot.min.css' crossorigin='anonymous' referrerpolicy='no-referrer'>
<style>body{{background:#111820;color:#dbe5ee;font:15px system-ui;margin:30px auto;max-width:1180px;padding:0 16px}}section{{background:#19232e;padding:16px;margin:16px 0;border-radius:8px}}h2{{font-size:18px}}.chart{{min-width:0}}.missing{{color:#e8b56a}}li{{margin:8px 0}}table{{font:12px monospace}}td{{padding:5px}}.u-legend{{white-space:normal;text-align:left}}.u-legend .u-series{{margin-right:12px}}.u-select{{background:#79b7ed30}}button{{background:#26394c;color:#dbe5ee;border:1px solid #6c859d;border-radius:5px;padding:8px 14px;cursor:pointer}}</style>
<style>.u-legend{{min-height:70px;font-variant-numeric:tabular-nums}}.u-legend th,.u-legend td{{white-space:nowrap}}.u-legend .u-value{{width:19ch;min-width:19ch;text-align:right}}.chart{{overflow-x:auto}}.chart-options{{display:flex;align-items:center;gap:20px;flex-wrap:wrap}}</style>
<h1>Weld run diagnostics</h1><p>{html.escape(run.name)} · {datetime.fromtimestamp(start, timezone.utc).isoformat()} · {end-start:.1f}s observed</p>
<p><strong>Codec: {html.escape(codec_label)}</strong></p>
<p><strong>Transport: {html.escape(transport_label)}</strong></p>
<ul>{warnings}</ul><p>Hover for values and a shared time cursor. Drag horizontally to zoom all charts; double-click or reset to see the whole run. Click legend entries to hide/show individual series. Series are not stacked or added together. Cumulative counters are differenced and rebaselined on resets; missing coverage stays blank.</p>
<p>Charts use CDN-loaded uPlot 1.6.32 and need Internet access (or cached assets). Log data is embedded here; no log upload is performed.</p>
<p>Dashed lines show whole-run averages and stay fixed when zooming. Visible averages cover only the selected time range. Run totals sum measured counter changes, excluding unknown initial baselines and gaps; different outcomes must not be added to decoded/imported totals.</p>
<div class='chart-options'><button id='reset-zoom' type='button'>Reset zoom</button><label><input id='lock-y-axis' type='checkbox'> Lock Y-axes to whole-run ranges</label></div><p id='chart-status' class='missing' role='status'>Loading charts… If this persists, check CDN access.</p><noscript>JavaScript is required to display the charts.</noscript>
{''.join(charts)}<section><h2>Encoder generation changes</h2><table><tr><th>Time</th><th>Stream/generation</th><th>Size</th><th>Cadence</th><th>Bitrate target</th></tr>{''.join(encoders) or '<tr><td>No changes recorded.</td></tr>'}</table></section>
<script src='{UPLOT_CDN}/uPlot.iife.min.js' crossorigin='anonymous' referrerpolicy='no-referrer'></script>
<script>{javascript}</script></html>"""


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("run", nargs="?", type=Path, help="run directory or local-hoist source log (default: latest run)")
    parser.add_argument("--output", type=Path)
    parser.add_argument("--no-open", action="store_true", help="generate the report without opening a browser")
    args = parser.parse_args(argv)
    if args.run is None:
        args.run = latest_run(ROOT / "target/validation")
    output = args.output or (args.run.with_suffix(".html") if args.run.is_file() else args.run / "diagnostics.html")
    output.write_text(report(args.run), encoding="utf-8")
    print(f"Report: {output.resolve()}")
    if not args.no_open:
        try:
            subprocess.run(["xdg-open", str(output.resolve())], check=True, timeout=10)
        except (OSError, subprocess.SubprocessError) as error:
            print(f"Report saved, but could not open it: {error}", file=sys.stderr)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError) as error:
        raise SystemExit(f"Could not plot run: {error}") from error

#!/usr/bin/env python3
"""Run real GPU-backed clients against paced headless presenters; save bounded logs."""
import argparse
import csv
import json
import os
from pathlib import Path
import resource
import shlex
import shutil
import signal
import subprocess
import tempfile
import time

LAYERS = ("surface", "empty-app", "core-app", "framework-main", "default-main", "renderer-main", "state-direct", "ui-direct", "extract-direct", "prepare-direct", "render-direct", "minimal", "master")

def collect_counters(process, log_path, directory, perf, seconds):
    deadline = time.monotonic() + 40
    while "MEASUREMENT_START" not in log_path.read_text():
        if process.poll() is not None or time.monotonic() >= deadline:
            raise RuntimeError("benchmark did not begin its measurement window")
        time.sleep(0.02)
    started = time.monotonic()
    with (directory / "counters.csv").open("w") as counters:
        subprocess.run([str(perf), "stat", "-x", ";", "-e", "instructions:u,cycles:u",
                        "-p", str(process.pid), "--", "sleep", str(seconds - 2)],
                       stderr=counters, check=True, timeout=seconds + 5,
                       env={**os.environ, "LC_ALL": "C"})
    duration = time.monotonic() - started
    if process.poll() is not None:
        raise RuntimeError("benchmark ended during counter collection")
    values = {}
    with (directory / "counters.csv").open() as counters:
        for row in csv.reader(counters, delimiter=";"):
            if len(row) >= 5 and row[2] in ("instructions:u", "cycles:u"):
                try:
                    count, coverage = int(row[0]), float(row[4])
                except ValueError as error:
                    raise RuntimeError(f"perf did not count {row[2]}") from error
                if count <= 0 or coverage < 99:
                    raise RuntimeError(f"insufficient perf coverage for {row[2]}")
                values[row[2]] = count
    if len(values) != 2:
        raise RuntimeError("perf did not return both requested counters")
    (directory / "counter-window.json").write_text(json.dumps({
        "seconds": duration,
        "counts": values,
        "scope": "userspace, attached Weld process and threads; interior measurement window",
    }, indent=2))

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--mode", choices=(*LAYERS, "all"), default="all")
    parser.add_argument("--repeat", type=int, default=1, help="repeat cases, reversing order every other pass")
    parser.add_argument("--perf", type=Path, help="optional perf binary for userspace instruction/cycle counters")
    parser.add_argument("--seconds", type=int, default=10)
    parser.add_argument("--warmup", type=int, default=3)
    parser.add_argument("--width", type=int, default=1920)
    parser.add_argument("--height", type=int, default=1080)
    parser.add_argument("--hz", type=int, default=60)
    parser.add_argument("--producer-hz", type=int, default=120)
    parser.add_argument("--input-hz", type=int, default=0)
    parser.add_argument("--windows", type=int, default=1)
    parser.add_argument("--decorations", choices=("client", "server"), default="client")
    parser.add_argument("--jobs", type=int, default=8)
    parser.add_argument("--no-build", action="store_true")
    parser.add_argument("--scanner", type=Path)
    args = parser.parse_args()
    if not 1 <= args.repeat <= 10:
        parser.error("repeat must be 1..10")
    if args.perf and args.seconds < 4:
        parser.error("counter collection requires at least four measurement seconds")
    if args.perf:
        try:
            args.perf = args.perf.resolve(strict=True)
        except OSError as error:
            parser.error(f"cannot use perf binary: {error}")
    if not (1 <= args.seconds <= 120 and 0 <= args.warmup <= 30 and 1 <= args.windows <= 8
            and 1 <= args.hz <= 240 and 1 <= args.producer_hz <= 1000 and 0 <= args.input_hz <= 2000
            and 64 <= args.width <= 8192 and 64 <= args.height <= 8192):
        parser.error("invalid workload bounds; use --help for the available controls")
    root = Path(__file__).resolve().parents[2]
    os.chdir(root)
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    build = root / "target/validation/paced-render-build"
    build.mkdir(parents=True, exist_ok=True)
    producer = build / "egl-producer"
    manifest = build / "executable.json"
    if not args.no_build:
        scanner = args.scanner or shutil.which("wayland-scanner")
        if not scanner:
            parser.error("wayland-scanner is required; pass --scanner /path/to/wayland-scanner")
        protocol_dir = subprocess.check_output(["pkg-config", "--variable=pkgdatadir", "wayland-protocols"], text=True).strip()
        protocol = Path(protocol_dir) / "stable/xdg-shell/xdg-shell.xml"
        subprocess.run([str(scanner), "client-header", str(protocol), str(build / "xdg-shell-client-protocol.h")], check=True)
        subprocess.run([str(scanner), "private-code", str(protocol), str(build / "xdg-shell-protocol.c")], check=True)
        decoration_protocol = Path(protocol_dir) / "unstable/xdg-decoration/xdg-decoration-unstable-v1.xml"
        subprocess.run([str(scanner), "client-header", str(decoration_protocol), str(build / "xdg-decoration-client-protocol.h")], check=True)
        subprocess.run([str(scanner), "private-code", str(decoration_protocol), str(build / "xdg-decoration-protocol.c")], check=True)
        flags = shlex.split(subprocess.check_output(["pkg-config", "--cflags", "--libs", "wayland-client", "wayland-egl", "egl", "glesv2"], text=True))
        subprocess.run(["cc", "-O3", "-Wall", "-Wextra", "-Werror", "-I", str(build), "scripts/profiling/egl-producer.c", str(build / "xdg-shell-protocol.c"), str(build / "xdg-decoration-protocol.c"), "-o", str(producer), *flags], check=True)
        executable = None
        with subprocess.Popen(["cargo", "bench", "--no-run", "--profile", "release", "--bench", "paced_render", "--features", "test-support", "--locked", "-j", str(args.jobs), "--message-format=json"], stdout=subprocess.PIPE, text=True) as cargo:
            for line in cargo.stdout:
                event = json.loads(line)
                if event.get("reason") == "compiler-artifact" and event.get("target", {}).get("name") == "paced_render":
                    executable = event.get("executable") or executable
                if event.get("reason") == "compiler-message":
                    print(event["message"].get("rendered", ""), end="")
            if cargo.wait() != 0 or not executable:
                raise RuntimeError("benchmark build failed")
        manifest.write_text(json.dumps({"executable": executable}))
    executable = json.loads(manifest.read_text())["executable"]
    resource.setrlimit(resource.RLIMIT_FSIZE, (128*1024*1024, 128*1024*1024))
    run = Path(tempfile.mkdtemp(prefix="paced-render-", dir=root / "target/validation"))
    print(f"Results: {run}", flush=True)
    environment = {**os.environ, "VK_LOADER_LAYERS_DISABLE": "VK_LAYER_KHRONOS_validation", "RUST_LOG": "warn"}
    (run / "settings.json").write_text(json.dumps({
        "options": {key: str(value) if isinstance(value, Path) else value for key, value in vars(args).items()},
        "executable": executable,
        "git_head": subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip(),
        "kernel": os.uname().release,
        "started_unix": time.time(),
        "cpu_accounting": "Weld process user+system; excludes producer and post-run GPU capture",
    }, indent=2))
    modes = LAYERS if args.mode == "all" else (args.mode,)
    cases = [(iteration, mode) for iteration in range(args.repeat)
             for mode in (modes if iteration % 2 == 0 else tuple(reversed(modes)))]
    for iteration, mode in cases:
        directory = run / (mode if args.repeat == 1 else f"{iteration + 1}-{mode}")
        directory.mkdir()
        command = [executable, "--mode", mode, "--producer", str(producer), "--run-dir", str(directory), "--decorations", args.decorations]
        for name in ("seconds", "warmup", "width", "height", "hz", "producer_hz", "input_hz", "windows"):
            command += ["--" + name.replace("_", "-"), str(getattr(args, name))]
        with (directory / "run.log").open("w") as log:
            process = subprocess.Popen(command, env=environment, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
            try:
                if args.perf:
                    collect_counters(process, directory / "run.log", directory, args.perf, args.seconds)
                code = process.wait(timeout=args.seconds + args.warmup + 30)
            finally:
                try:
                    os.killpg(process.pid, signal.SIGTERM)
                except ProcessLookupError:
                    pass
                try:
                    process.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    os.killpg(process.pid, signal.SIGKILL)
                    process.wait()
        lines = (directory / "run.log").read_text().splitlines()
        for line in lines:
            if line.startswith(("CASE", "ADAPTER", "RESULT")):
                print(line, flush=True)
        if code != 0 or not any(line.startswith("RESULT") for line in lines):
            raise RuntimeError(f"{mode} failed: inspect {directory / 'run.log'}")

if __name__ == "__main__":
    main()

#!/usr/bin/env bash

set -euo pipefail

usage() {
    cat <<'EOF'
Usage: pointer-motion-perf-suite [OPTIONS]

Capture equal-duration still, rapid-motion, and still-again DRM profiles. The
suite generates full flamegraphs for every run and comparison artifacts only
when all captures are lossless and the two still baselines drift by at most 10%.

Options:
  --warmup SECONDS     Startup time before each loss probe (default: 2)
  --duration SECONDS   Main capture time for each run (default: 20)
  --frequency HZ       cpu-clock sample frequency (default: 499)
  --mmap-pages PAGES   Perf ring pages for every run (default: 64)
  --stack-bytes BYTES  DWARF stack size for every run (default: 16384)
  --output-dir PATH    Explicit artifact directory
  --force              Replace an explicitly selected output directory
  -h, --help           Show this help

Run this script from a real TTY. Do not switch VTs during a capture.
EOF
}

fail() {
    printf 'pointer-motion-perf-suite: %s\n' "$*" >&2
    exit 2
}

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repository_root="$(cd -- "${script_dir}/../.." && pwd)"
warmup=2
duration=20
frequency=499
mmap_pages=64
stack_bytes=16384
output_dir=""
force=false
readonly PROMPT_SECONDS=8
readonly PREFLIGHT_SECONDS=3
readonly DRIFT_LIMIT_PERCENT=10
readonly TASK_CLOCK_DRIFT_FLOOR_MSEC=50
readonly SAMPLE_DRIFT_FLOOR=20

while (( $# > 0 )); do
    case "$1" in
        --warmup|--duration|--frequency|--mmap-pages|--stack-bytes|--output-dir)
            (( $# >= 2 )) || fail "$1 requires a value"
            case "$1" in
                --warmup) warmup="$2" ;;
                --duration) duration="$2" ;;
                --frequency) frequency="$2" ;;
                --mmap-pages) mmap_pages="$2" ;;
                --stack-bytes) stack_bytes="$2" ;;
                --output-dir) output_dir="$2" ;;
            esac
            shift 2
            ;;
        --force)
            force=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            fail "unknown option: $1"
            ;;
    esac
done

[[ -t 0 && -t 1 ]] || fail "this suite must run interactively from a real TTY"
timestamp="$(date +%Y%m%d-%H%M%S)"
if [[ -z "${output_dir}" ]]; then
    output_dir="${repository_root}/target/perf-traces/pointer-motion-${timestamp}"
elif [[ "${output_dir}" != /* ]]; then
    output_dir="${repository_root}/${output_dir}"
fi
if [[ -e "${output_dir}" && "${force}" != true ]]; then
    fail "output directory exists; pass --force to replace it"
fi
mkdir -p -- "${output_dir}"
if [[ "${force}" == true ]]; then
    rm -f -- \
        "${output_dir}/comparison.txt" \
        "${output_dir}/still-to-rapid.ratio.txt" \
        "${output_dir}/still-to-rapid.delta-abs.txt" \
        "${output_dir}/still-drift.ratio.txt" \
        "${output_dir}/still-to-rapid.diff.folded" \
        "${output_dir}/still-to-rapid.diff.svg"
fi

printf 'Building the optimized symbolized binary before the suite starts...\n' >&2
cd -- "${repository_root}"
cargo build --profile perf -p weldwm

runner_options=(
    --backend drm
    --warmup "${warmup}"
    --duration "${duration}"
    --frequency "${frequency}"
    --mmap-pages "${mmap_pages}"
    --stack-bytes "${stack_bytes}"
    --no-build
    --no-print-instructions
)
if [[ "${force}" == true ]]; then
    runner_options+=(--force)
fi

run_profile() {
    local number="$1"
    local label="$2"
    local action="$3"
    printf '\nNext profile %s of 3: %s\n' "${number}" "${label}"
    printf 'Instructions: %s\n' "${action}"
    printf 'Timing after Weld appears: %s seconds warmup, %s seconds preflight, %s seconds capture.\n' \
        "${warmup}" "${PREFLIGHT_SECONDS}" "${duration}"
    printf 'Output: %s/%s.*\n' "${output_dir}" "${label}"
    printf 'Starting in %s seconds. Continue the action until Weld exits.\n' \
        "${PROMPT_SECONDS}"
    sleep "${PROMPT_SECONDS}"
    set +e
    "${script_dir}/run-perf" \
        --name "pointer-${label}" \
        --instructions "${action}" \
        --output-base "${output_dir}/${label}" \
        "${runner_options[@]}"
    status=$?
    set -e
    case "${status}" in
        0|3) return 0 ;;
        *) return "${status}" ;;
    esac
}

run_profile 1 still-before \
    'Leave the pointer completely still over the empty Weld desktop.'
run_profile 2 rapid \
    'Move the pointer rapidly and continuously over the empty Weld desktop.'
run_profile 3 still-after \
    'Leave the pointer completely still over the empty Weld desktop.'

resolve_tool() {
    local command_name="$1"
    local package="$2"
    local resolved
    resolved="$(command -v "${command_name}" || true)"
    if [[ -z "${resolved}" ]]; then
        store_path="$(nix build --no-link --print-out-paths "${package}")"
        resolved="${store_path}/bin/${command_name}"
    fi
    [[ -x "${resolved}" ]] || fail "comparison tool unavailable: ${command_name}"
    printf '%s\n' "${resolved}"
}

perf_bin="$(resolve_tool perf nixpkgs#linuxPackages.perf)"
difffolded_bin="$(resolve_tool difffolded.pl nixpkgs#flamegraph)"
flamegraph_bin="$(resolve_tool flamegraph.pl nixpkgs#flamegraph)"

quality_ok=true
for label in still-before rapid still-after; do
    if ! rg -q '^valid=true$' "${output_dir}/${label}.quality.txt"; then
        quality_ok=false
    fi
done

metric() {
    local file="$1"
    local key="$2"
    awk -F= -v key="${key}" '$1 == key { print $2; exit }' "${file}"
}

still_before_clock="$(metric "${output_dir}/still-before.cpu.txt" task_clock_msec)"
still_after_clock="$(metric "${output_dir}/still-after.cpu.txt" task_clock_msec)"
still_before_samples="$(metric "${output_dir}/still-before.quality.txt" sample_count)"
still_after_samples="$(metric "${output_dir}/still-after.quality.txt" sample_count)"
rapid_samples="$(metric "${output_dir}/rapid.quality.txt" sample_count)"
for value in \
    "${still_before_clock}" \
    "${still_after_clock}" \
    "${still_before_samples}" \
    "${still_after_samples}" \
    "${rapid_samples}"; do
    [[ "${value}" =~ ^[0-9]+([.][0-9]+)?$ ]] || fail "comparison metric is not numeric: ${value}"
done
task_clock_drift="$(awk -v first="${still_before_clock}" -v second="${still_after_clock}" '
    BEGIN {
        mean = (first + second) / 2
        difference = first > second ? first - second : second - first
        printf "%.3f", mean == 0 ? (difference == 0 ? 0 : 100) : 100 * difference / mean
    }
')"
task_clock_difference="$(awk -v first="${still_before_clock}" -v second="${still_after_clock}" \
    'BEGIN { difference = first > second ? first - second : second - first; printf "%.3f", difference }')"
sample_drift=not_applicable
sample_drift_ok=true
sample_difference=$((still_before_samples > still_after_samples \
    ? still_before_samples - still_after_samples \
    : still_after_samples - still_before_samples))
if (( still_before_samples > 0 && still_after_samples > 0 )); then
    sample_drift="$(awk -v first="${still_before_samples}" -v second="${still_after_samples}" '
        BEGIN {
            mean = (first + second) / 2
            difference = first > second ? first - second : second - first
            printf "%.3f", 100 * difference / mean
        }
    ')"
    sample_drift_ok="$(awk \
        -v drift="${sample_drift}" \
        -v difference="${sample_difference}" \
        -v limit="${DRIFT_LIMIT_PERCENT}" \
        -v floor="${SAMPLE_DRIFT_FLOOR}" \
        'BEGIN { print drift <= limit || difference <= floor ? "true" : "false" }')"
fi
task_clock_drift_ok="$(awk \
    -v drift="${task_clock_drift}" \
    -v difference="${task_clock_difference}" \
    -v limit="${DRIFT_LIMIT_PERCENT}" \
    -v floor="${TASK_CLOCK_DRIFT_FLOOR_MSEC}" \
    'BEGIN { print drift <= limit || difference <= floor ? "true" : "false" }')"
drift_ok=false
if [[ "${task_clock_drift_ok}" == true && "${sample_drift_ok}" == true ]]; then
    drift_ok=true
fi
symbol_comparison_available=false
if [[ "${quality_ok}" == true && "${drift_ok}" == true ]] \
    && (( still_before_samples > 0 && rapid_samples > 0 )); then
    symbol_comparison_available=true
fi

summary="${output_dir}/comparison.txt"
{
    printf 'event=cpu-clock:u\n'
    printf 'duration_seconds=%s\n' "${duration}"
    printf 'frequency_hz=%s\n' "${frequency}"
    printf 'mmap_pages=%s\n' "${mmap_pages}"
    printf 'stack_bytes=%s\n' "${stack_bytes}"
    printf 'quality_ok=%s\n' "${quality_ok}"
    printf 'still_task_clock_drift_percent=%s\n' "${task_clock_drift}"
    printf 'still_task_clock_difference_msec=%s\n' "${task_clock_difference}"
    printf 'task_clock_drift_floor_msec=%s\n' "${TASK_CLOCK_DRIFT_FLOOR_MSEC}"
    printf 'still_sample_drift_percent=%s\n' "${sample_drift}"
    printf 'still_sample_difference=%s\n' "${sample_difference}"
    printf 'sample_drift_floor=%s\n' "${SAMPLE_DRIFT_FLOOR}"
    printf 'drift_limit_percent=%s\n' "${DRIFT_LIMIT_PERCENT}"
    printf 'drift_ok=%s\n' "${drift_ok}"
    printf 'symbol_comparison_available=%s\n\n' "${symbol_comparison_available}"
    for label in still-before rapid still-after; do
        printf '[%s]\n' "${label}"
        printf 'sample_count=%s\n' "$(metric "${output_dir}/${label}.quality.txt" sample_count)"
        printf 'flamegraph_available=%s\n' \
            "$(metric "${output_dir}/${label}.quality.txt" flamegraph_available)"
        cat "${output_dir}/${label}.cpu.txt"
        printf '\n'
    done
    printf 'Sample counts and task-clock are time-proportional. Do not infer CPU time\n'
    printf 'from percentage-only symbol columns. Kernel stacks are not captured.\n'
} >"${summary}"

if [[ "${quality_ok}" == true ]] \
    && (( still_before_samples > 0 && still_after_samples > 0 )); then
    "${perf_bin}" diff -c ratio \
        "${output_dir}/still-before.data" "${output_dir}/still-after.data" \
        >"${output_dir}/still-drift.ratio.txt"
fi

comparison_valid=true
if [[ "${symbol_comparison_available}" == true ]]; then
    "${perf_bin}" diff -c ratio \
        "${output_dir}/still-before.data" "${output_dir}/rapid.data" \
        >"${output_dir}/still-to-rapid.ratio.txt"
    "${perf_bin}" diff -c delta-abs \
        "${output_dir}/still-before.data" "${output_dir}/rapid.data" \
        >"${output_dir}/still-to-rapid.delta-abs.txt"
    "${difffolded_bin}" \
        "${output_dir}/still-before.folded" "${output_dir}/rapid.folded" \
        >"${output_dir}/still-to-rapid.diff.folded"
    "${flamegraph_bin}" \
        --title 'Weld rapid pointer minus still, absolute samples' \
        --countname samples \
        "${output_dir}/still-to-rapid.diff.folded" \
        >"${output_dir}/still-to-rapid.diff.svg"
elif [[ "${quality_ok}" != true || "${drift_ok}" != true ]]; then
    comparison_valid=false
    printf '\nComparison artifacts refused because capture quality or baseline drift failed.\n' \
        >>"${summary}"
    printf 'Comparison artifacts were refused; inspect %s.\n' "${summary}" >&2
else
    printf '\nSymbol comparison unavailable because the still baseline or rapid capture had no userspace samples.\n' \
        >>"${summary}"
fi

printf '\nPerf suite complete.\nSummary: %s\n' "${summary}"
if [[ "$(metric "${output_dir}/rapid.quality.txt" flamegraph_available)" == true ]]; then
    printf 'Rapid flamegraph: %s\n' "${output_dir}/rapid.svg"
else
    printf 'Rapid flamegraph: unavailable because rapid motion produced no userspace samples.\n'
fi
if [[ "${comparison_valid}" != true ]]; then
    exit 3
fi

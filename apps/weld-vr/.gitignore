# Godot's regenerable import cache and local editor state.
/.godot/

# Local Android build/export artifacts and signing keys.
/android/
/build/
/target/
/rust/target/
/bin/
*.apk
*.aab
*.keystore
*.jks
export_credentials.cfg

# Optional local scenery; neither third-party assets nor their scene wrappers
# are required by a clean checkout. Godot can still import/export them locally.
/environments/

; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="WeldVR"
run/main_scene="uid://d1bgda50xmko3"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

XRToolsUserSettings="*uid://bqgb8i74tm0t"
XRToolsRumbleManager="*uid://by853dk86g1qw"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-xr-tools/plugin.cfg", "res://addons/weld-rust-build/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
; Compatibility/OpenGL enables EGLImage import of native decoder buffers without
; CPU pixel readback. Godot 4.7.1 lacks the Vulkan device-extension opt-in needed
; for our external-memory path; revisit when this upstream work is available:
; https://github.com/godotengine/godot/pull/114940
; That PR enables requesting extensions, not a complete video importer. Vulkan
; will still need native-buffer import, synchronization and lifetime handling.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
gl_compatibility/driver.linuxbsd="opengl3_es"
textures/vram_compression/import_etc2_astc=true

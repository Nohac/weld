#!/usr/bin/env bash
set -euo pipefail
# Failed native engine checks must not create multi-gigabyte core dumps.
ulimit -c 0

project_directory=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
desktop_cursor=false
case "${1:-}" in
  '') build_target=desktop ;;
  --android-export) build_target=android ;;
  --desktop-cursor) build_target=desktop; desktop_cursor=true ;;
  *) printf '%s\n' 'Usage: check-gdextension [--android-export|--desktop-cursor]' >&2; exit 2 ;;
esac
if [[ $# -gt 1 ]]; then
  printf '%s\n' 'Usage: check-gdextension [--android-export|--desktop-cursor]' >&2
  exit 2
fi
if [[ "$build_target" == android ]] && ! command -v apkanalyzer >/dev/null 2>&1; then
  printf '%s\n' 'Android export checks require apkanalyzer from the Android SDK command-line tools on PATH.' >&2
  exit 1
fi
"$project_directory/scripts/build-gdextension" "$build_target"

work_directory=$(mktemp -d "${TMPDIR:-/tmp}/weld-vr-check.XXXXXX")
trap 'rm -rf -- "$work_directory"' EXIT
mkdir -p "$work_directory/project"
# Do not copy editor state, Cargo outputs, export presets or signing credentials.
cp -a -- "$project_directory/project.godot" "$project_directory/icon.svg" \
  "$project_directory/weld_vr.gdextension" "$project_directory/weld_vr.gdextension.uid" \
  "$project_directory/scenes" \
  "$project_directory/tests" "$project_directory/addons" "$project_directory/bin" \
  "$project_directory/scripts" \
  "$work_directory/project/"

run_godot() {
  env XDG_CONFIG_HOME="$work_directory/config" XDG_DATA_HOME="$work_directory/data" \
    XDG_CACHE_HOME="$work_directory/cache" \
    ADB_SERVER_SOCKET="localfilesystem:$work_directory/adb.sock" \
    timeout 90s godot --headless --path "$work_directory/project" "$@"
}

check_log() {
  if grep -nE 'SCRIPT ERROR:|(^|[[:space:]])ERROR:' "$1"; then
    printf '%s\n' 'Godot reported an error despite its process exit status.' >&2
    exit 1
  fi
}

# Bootstrap the UID database before asking a fresh editor to resolve the main
# scene. Only the disposable copy omits this setting during its first import.
sed -i '/^run\/main_scene=/d' "$work_directory/project/project.godot"
if ! run_godot --import > "$work_directory/import.log" 2>&1; then
  cat "$work_directory/import.log" >&2
  exit 1
fi
check_log "$work_directory/import.log"
cp -- "$project_directory/project.godot" "$work_directory/project/project.godot"
if ! run_godot --script res://tests/gdextension_smoke.gd > "$work_directory/test.log" 2>&1; then
  cat "$work_directory/test.log" >&2
  exit 1
fi
check_log "$work_directory/test.log"
cat "$work_directory/test.log"
if ! grep -qx 'WELD_VR_GDEXTENSION_SMOKE_OK' "$work_directory/test.log"; then
  printf '%s\n' 'Godot did not report successful completion of the integration check.' >&2
  exit 1
fi

if [[ "$desktop_cursor" == true ]]; then
  # Opt-in real display check. Keep editor settings and ADB isolated, and
  # --script prevents the production scene from auto-connecting to a source.
  if ! env XDG_CONFIG_HOME="$work_directory/config" XDG_DATA_HOME="$work_directory/data" \
    XDG_CACHE_HOME="$work_directory/cache" \
    ADB_SERVER_SOCKET="localfilesystem:$work_directory/adb.sock" \
    timeout 30s godot --path "$work_directory/project" \
      --display-driver wayland --rendering-driver opengl3_es \
      --script res://tests/cursor_smoke.gd > "$work_directory/cursor.log" 2>&1; then
    cat "$work_directory/cursor.log" >&2
    exit 1
  fi
  cat "$work_directory/cursor.log"
  check_log "$work_directory/cursor.log"
  grep -q '^WELD_CURSOR_SMOKE_OK display=' "$work_directory/cursor.log"
fi

# Exercise target selection and a failed compiler without changing real sources
# or libraries. Exercise the shared runner without opening an editor UI.
if ! run_godot --script res://tests/manifest_smoke.gd > "$work_directory/manifest.log" 2>&1; then
  cat "$work_directory/manifest.log" >&2
  exit 1
fi
check_log "$work_directory/manifest.log"
cat "$work_directory/manifest.log"
grep -qx 'WELD_MANIFEST_SMOKE_OK' "$work_directory/manifest.log"
cp -- "$project_directory/tests/fixtures/build-gdextension" \
  "$work_directory/project/scripts/build-gdextension"
if ! run_godot --script res://tests/build_hook_smoke.gd > "$work_directory/hooks.log" 2>&1; then
  cat "$work_directory/hooks.log" >&2
  exit 1
fi
cat "$work_directory/hooks.log"
grep -qx 'WELD_BUILD_HOOK_SMOKE_OK' "$work_directory/hooks.log"
check_log "$work_directory/hooks.log"

if [[ "$build_target" == android ]]; then
  template_version=$(godot --version | cut -d. -f1-4)
  template_directory="${XDG_DATA_HOME:-$HOME/.local/share}/godot/export_templates/$template_version"
  if [[ ! -f "$template_directory/android_debug.apk" ]]; then
    printf 'Missing Godot Android export template: %s\n' "$template_directory" >&2
    exit 1
  fi
  mkdir -p "$work_directory/data/godot/export_templates"
  ln -s -- "$template_directory" "$work_directory/data/godot/export_templates/$template_version"
  cp -- "$project_directory/export_presets.cfg" "$work_directory/project/export_presets.cfg"
  # Use no signing credentials, and do not enumerate/deploy to attached devices.
  sed -i -e 's/^package\/signed=true$/package\/signed=false/' \
    -e '/^\[runnable_presets\]$/,/^\[preset\.0\]$/ { /^\[preset\.0\]$/!d; }' \
    "$work_directory/project/export_presets.cfg"
  # Use the real resource selection, including the Rust-owned pointer scene.
  for outcome in success failure; do
    if [[ "$outcome" == failure ]]; then
      touch "$work_directory/project/scripts/fail-build"
    fi
    if ! run_godot --export-debug 'Android Phone' "$work_directory/$outcome.apk" \
      > "$work_directory/$outcome.log" 2>&1; then
      cat "$work_directory/$outcome.log" >&2
      exit 1
    fi
    if [[ "$outcome" == success ]]; then
      check_log "$work_directory/$outcome.log"
      grep -Fq '[Weld Rust] Checking android debug build...' "$work_directory/$outcome.log"
    else
      # Godot exits 0 despite an export-plugin error. Assert the warning and
      # preserved library, never interpret that exit status as a fresh build.
      grep -q 'Weld Rust android build failed (exit 23)' "$work_directory/$outcome.log"
      grep -q 'Godot may still deploy the previous library' "$work_directory/$outcome.log"
    fi
    unzip -p "$work_directory/$outcome.apk" lib/arm64-v8a/libweld_vr.so \
      | cmp - "$project_directory/bin/android/debug/libweld_vr.so"
    unzip -Z1 "$work_directory/$outcome.apk" > "$work_directory/$outcome-files"
    apkanalyzer manifest print "$work_directory/$outcome.apk" > "$work_directory/$outcome-manifest.xml"
    grep -q 'package="com.example.weldvr"' "$work_directory/$outcome-manifest.xml"
    if grep -q 'android:name="handtracking"' "$work_directory/$outcome-manifest.xml"; then
      printf '%s\n' 'Phone export must not declare Pico hand-tracking capabilities.' >&2
      exit 1
    fi
    for library in weld_vr avutil avcodec avformat; do
      grep -qx "lib/arm64-v8a/lib$library.so" "$work_directory/$outcome-files"
    done
    for resource in scenes/video_panel.tscn.remap \
      scenes/controller_pointer.tscn.remap; do
      grep -qx "assets/$resource" "$work_directory/$outcome-files"
    done
    if grep -E '^assets/(tests/|addons/weld-rust-build/|addons/godot-xr-tools/)' "$work_directory/$outcome-files"; then
      printf '%s\n' 'Editor/test code leaked into the APK.' >&2
      exit 1
    fi
  done
  printf '%s\n' 'WELD_ANDROID_EXPORT_HOOK_OK (including expected soft failure)'
fi

  "productions": {
    "Border": {
      "variants": {
        "Normal": "BorderWidth",
        "Pixel": "BorderWidth",
        "None": null
      },
      "rules": [
        {
          "pattern": [
            "normal"
          ],
          "value": "Self::Normal(BorderWidth::new(3)?)"
        },
        {
          "pattern": [
            "normal",
            "$width:BorderWidth"
          ],
          "value": "Self::Normal(width)"
        },
        {
          "pattern": [
            "pixel"
          ],
          "value": "Self::Pixel(BorderWidth::new(3)?)"
        },
        {
          "pattern": [
            "pixel",
            "$width:BorderWidth"
          ],
          "value": "Self::Pixel(width)"
        },
        {
          "pattern": [
            "none"
          ],
          "value": "Self::None"
        }
      ],
      "fallback": "invalid"
    },
    "ModeHeader": {
      "variants": {
        "Plain": "ModeName",
        "Markup": "ModeName"
      },
      "rules": [
        {
          "pattern": [
            "$name:ModeName"
          ],
          "value": "Self::Plain(name)"
        },
        {
          "pattern": [
            "--pango_markup",
            "$name:ModeName"
          ],
          "value": "Self::Markup(name)"
        }
      ],
      "fallback": "invalid"
    },
